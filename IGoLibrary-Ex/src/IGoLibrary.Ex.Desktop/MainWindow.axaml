<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IGoLibrary.Ex.Desktop.ViewModels"
        xmlns:controls="using:IGoLibrary.Ex.Desktop.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        mc:Ignorable="d"
        x:Class="IGoLibrary.Ex.Desktop.MainWindow"
        x:Name="MainWindowRoot"
        x:DataType="vm:MainWindowViewModel"
        Title="IGoLibrary-Ex"
        Width="1188"
        Height="840"
        MinWidth="1000"
        MinHeight="680"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Background="Transparent"
        Icon="/Assets/main.ico">

  <Window.Resources>
    <ControlTheme x:Key="SettingsCenterTabStripItemTheme"
                  TargetType="primitives:TabStripItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="*,2"
                Background="{TemplateBinding Background}">
            <ContentPresenter Grid.Row="0"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <Border x:Name="PART_SettingsAccentLine"
                    Grid.Row="1"
                    Height="2"
                    Background="Transparent" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_SettingsAccentLine">
        <Setter Property="Background" Value="{DynamicResource SemiAccentBrush}" />
      </Style>
    </ControlTheme>

    <PathGeometry x:Key="IconHome">M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z</PathGeometry>
    <PathGeometry x:Key="IconLogin">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</PathGeometry>
    <PathGeometry x:Key="IconGrab">M7 2v11h3v9l7-12h-4l4-8z</PathGeometry>
    <PathGeometry x:Key="IconOccupy">M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z</PathGeometry>
    <PathGeometry x:Key="IconSettings">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</PathGeometry>
    <PathGeometry x:Key="IconEventKey">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2.18 12C8.16 14 6.82 12.66 6.82 11s1.34-3 3-3c1.3 0 2.41.84 2.83 2H19v2h-2v2h-2v-2h-2.35c-.42 1.16-1.53 2-2.83 2zm0-2c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1z</PathGeometry>
    <PathGeometry x:Key="IconEventFailure">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</PathGeometry>
    <PathGeometry x:Key="IconBuilding">M3 21V3h10v18H3zm12 0v-8h6v8h-6zM5 5v2h2V5H5zm4 0v2h2V5H9zM5 9v2h2V9H5zm4 0v2h2V9H9zm-4 4v2h2v-2H5zm4 0v2h2v-2H9zm8 2v4h2v-4h-2z</PathGeometry>
    <PathGeometry x:Key="IconClock">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5h-2v6l5 3 .9-1.5-3.9-2.3V7z</PathGeometry>
    <PathGeometry x:Key="IconHourglass">M6 2h12v6c0 1.5-.8 2.8-2.1 4 1.3 1.2 2.1 2.5 2.1 4v6H6v-6c0-1.5.8-2.8 2.1-4C6.8 10.8 6 9.5 6 8V2zm2 2v4c0 1.1.9 2.1 2.6 3l1.4.8 1.4-.8C15.1 10.1 16 9.1 16 8V4H8zm4 8.9-1.4.8C8.9 14.6 8 15.6 8 16.7V20h8v-3.3c0-1.1-.9-2.1-2.6-3l-1.4-.8z</PathGeometry>
    <PathGeometry x:Key="IconFolderOpen">M20 6h-8l-2-2H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z</PathGeometry>
    <PathGeometry x:Key="IconRestore">M13 3a9 9 0 0 0-9 9H1l4 4 4-4H6a7 7 0 1 1 2.05 4.95l-1.42 1.42A9 9 0 1 0 13 3z</PathGeometry>

  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.storage-text-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SemiAccentBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SemiCardBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiCardBorderBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="16,4" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="primitives|TabStrip.settings-center-tabs">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsCenterTabStripItemTheme}" />
    </Style>
    <Style Selector="primitives|TabStrip.settings-center-tabs primitives|TabStripItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.semi-card">
      <Setter Property="Background" Value="{DynamicResource SemiCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="TextBlock.semi-section-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.hero-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hero-meta">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.helper-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.grab-stat-card">
      <Setter Property="Background" Value="{DynamicResource SemiCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.grab-stat-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.grab-stat-value">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.dashboard-card">
      <Setter Property="Background" Value="{DynamicResource DashboardSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.home-minimal-card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#EAEAEA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #0C000000" />
    </Style>
    <Style Selector="TextBlock.dashboard-eyebrow">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dashboard-hero-title">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="38" />
    </Style>
    <Style Selector="TextBlock.dashboard-hero-subtitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.dashboard-clock-date">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.dashboard-clock-time">
      <Setter Property="FontSize" Value="36" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.dashboard-card-title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dashboard-stat-value">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dashboard-detail">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.dashboard-ticket-seat">
      <Setter Property="FontSize" Value="76" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="LineHeight" Value="82" />
    </Style>
    <Style Selector="TextBlock.dashboard-ticket-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.dashboard-ticket-body">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiTextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.dashboard-info-row">
      <Setter Property="Background" Value="{DynamicResource DashboardMutedSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.dashboard-reservation-detail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.dashboard-reservation-icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="#F5F6F8" />
      <Setter Property="BorderBrush" Value="#EAEAEA" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notify-toggle-card">
      <Setter Property="Background" Value="{DynamicResource DashboardMutedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate x:DataType="vm:SidebarNavigationItem">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <PathIcon Data="{Binding IconPathData}" Width="18" Height="18" Opacity="0.8"/>
        <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:DataType="vm:SeatItemViewModel">
      <Grid Width="52"
            Height="52"
            Margin="3"
            ClipToBounds="False"
            IsVisible="{Binding IsFilterVisible}">
        <ToolTip.Tip>
          <Border MinWidth="152"
                  MaxWidth="248"
                  Padding="3">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding SeatName, StringFormat=座位 {0}}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="White" />
              <Border Height="1"
                      Background="#26FFFFFF" />
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="6">
                <TextBlock Text="标识"
                           FontSize="12"
                           Foreground="#FFA9B4C4" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SeatKey}"
                           FontSize="12"
                           Foreground="#FFE7EDF5"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Text="状态"
                           FontSize="12"
                           Foreground="#FFA9B4C4" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFF4F7FB" />
                <TextBlock Grid.Row="2"
                           Text="标签"
                           FontSize="12"
                           Foreground="#FFA9B4C4"
                           IsVisible="{Binding HasLabel}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding LabelText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFBFD7FF"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasLabel}" />
              </Grid>
            </StackPanel>
          </Border>
        </ToolTip.Tip>

        <Grid.ContextMenu>
          <ContextMenu IsVisible="{Binding SupportsLabelEditing}">
            <MenuItem Header="{Binding LabelMenuHeader}"
                      Command="{Binding EditLabelCommand}" />
            <MenuItem Header="删除标签"
                      Command="{Binding DeleteLabelCommand}"
                      IsVisible="{Binding HasLabel}" />
          </ContextMenu>
        </Grid.ContextMenu>

        <Border CornerRadius="12"
                Background="{DynamicResource SemiColorFill0}"
                BorderThickness="1.5"
                BorderBrush="{DynamicResource SemiSuccessTextBrush}"
                IsVisible="{Binding IsAvailable}" />

        <Border CornerRadius="12"
                Background="{DynamicResource SemiColorFill2}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiCardBorderBrush}"
                IsVisible="{Binding IsUnavailable}" />

        <Border CornerRadius="12"
                Background="{DynamicResource SemiAccentSoftBrush}"
                BorderThickness="2"
                BorderBrush="{DynamicResource SemiAccentBrush}"
                IsVisible="{Binding IsSelected}" />

        <TextBlock x:Name="SeatNameTextBlock"
                   Text="{Binding SeatName}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SemiColorText0}"
                   Classes.unavailable="{Binding IsUnavailable}">
          <TextBlock.Styles>
            <Style Selector="TextBlock.unavailable">
              <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>

        <Grid Width="16"
              Height="16"
              Margin="-3,-3,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsVisible="{Binding HasLabel}">
          <Path Data="M2,2 L8,2 L15,9 L9,15 L2,8 Z"
                Fill="{DynamicResource SemiAccentBrush}"
                Stroke="{DynamicResource SemiAccentBrush}"
                StrokeThickness="1.8"
                Stretch="Fill" />
          <Ellipse Width="3"
                   Height="3"
                   Margin="4,4,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Fill="{DynamicResource AppAccentForegroundBrush}" />
        </Grid>

        <Path Width="18"
              Height="18"
              Margin="0,-4,-4,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Fill="{DynamicResource AppFavoriteFillBrush}"
              Stroke="{DynamicResource AppFavoriteStrokeBrush}"
              StrokeThickness="1"
              Stretch="Fill"
              IsVisible="{Binding IsFavorite}"
              Data="M12 2.2L14.9 8.07L21.38 9.01L16.69 13.58L17.8 20.03L12 16.98L6.2 20.03L7.31 13.58L2.62 9.01L9.1 8.07Z" />

        <ToggleButton IsChecked="{Binding IsSelected}"
                      Background="Transparent"
                      BorderThickness="0"
                      Opacity="0.01"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:DataType="vm:LogLineViewModel">
      <TextBlock Margin="0,0,0,8"
                 FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                 FontSize="12.5"
                 LineHeight="20"
                 TextWrapping="Wrap">
        <Run Text="{Binding TimestampText}" Foreground="{DynamicResource SemiColorText2}" />
        <Run Text=" " />
        <Run Text="{Binding Message}" Foreground="{Binding MessageBrush}" />
      </TextBlock>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="232,*">
    
    <!-- Sidebar -->
    <Border x:Name="SidebarPanel"
            Grid.Column="0"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="{DynamicResource AppSidebarBorderBrush}"
            BorderThickness="0,0,1,0"
            PointerPressed="OnSidebarPointerPressed">
      <Grid RowDefinitions="40, *, Auto">
        <!-- Window Title / Drag Area -->
        <TextBlock Grid.Row="0" Text="IGoLibrary-Ex 端" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.7" IsHitTestVisible="False"/>
        
        <!-- Navigation Menu -->
        <ListBox Grid.Row="1"
                 x:Name="SidebarNavigationList"
                 Classes="sidebar"
                 ItemsSource="{Binding SidebarItems}"
                 SelectedItem="{Binding SelectedSidebarItem}"
                 IsHitTestVisible="{Binding IsSidebarNavigationInteractive}"
                 Margin="0,16,0,0"
                 Background="Transparent"
                 BorderThickness="0" />
        
        <!-- Bottom Info -->
        <StackPanel Grid.Row="2" Margin="24,24,24,32" Spacing="8" IsVisible="{Binding HasSidebarSessionExpiration}">
          <TextBlock Text="Cookie 到期时间" FontSize="12" Opacity="0.5" FontWeight="Bold"/>
          <TextBlock Text="{Binding SidebarSessionExpirationText}" FontSize="13" TextWrapping="Wrap" Foreground="{Binding SidebarSessionExpirationBrush}" Opacity="0.9"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content Area -->
    <Grid Grid.Column="1"
          RowDefinitions="40, *">
      <!-- Top drag area for content pane -->
      <Border Grid.Row="0"
              Background="#F5F6F8"
              IsHitTestVisible="False" />
      <Border Grid.Row="1"
              Background="#F5F6F8"
              IsHitTestVisible="False" />
      
      <!-- Views -->
      <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="24,8,24,24">
        <Carousel.PageTransition>
          <CrossFade Duration="0:0:0.25" />
        </Carousel.PageTransition>
        
        <!-- Tab 0: Home -->
        <ScrollViewer Background="#F5F6F8">
          <StackPanel Spacing="14" Margin="0,0,16,0">
            <Border Classes="dashboard-card home-minimal-card"
                    Background="#FFFFFF"
                    Padding="22,20">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                <StackPanel Spacing="14">
                  <Border Background="{DynamicResource AppAccentPanelBrush}"
                          BorderBrush="{DynamicResource AppAccentPanelBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="999"
                          Padding="12,5"
                          HorizontalAlignment="Left">
                    <TextBlock Classes="dashboard-eyebrow"
                               Foreground="{DynamicResource SemiAccentBrush}"
                               Text="个人专属仪表盘" />
                  </Border>

                  <StackPanel Spacing="6"
                              MaxWidth="580">
                    <TextBlock Classes="dashboard-hero-title"
                               Text="{Binding HomeGreetingTitleText}" />
                    <TextBlock Classes="dashboard-hero-subtitle"
                               Text="{Binding HomeGreetingMessageText}" />
                  </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch">
                  <StackPanel Spacing="10"
                              HorizontalAlignment="Right">
                    <TextBlock Classes="dashboard-clock-date"
                               HorizontalAlignment="Right"
                               Text="{Binding HomeDashboard.HomeDateText}" />
                    <TextBlock Classes="dashboard-clock-time"
                               HorizontalAlignment="Right"
                               Text="{Binding HomeDashboard.HomeTimeText}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="16">
              <Border Classes="dashboard-card home-minimal-card" Padding="18,16">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="6"
                      MinHeight="72">
                  <TextBlock Classes="dashboard-eyebrow" Text="当前锁定场馆" />
                  <TextBlock Classes="dashboard-card-title"
                             Grid.Row="1"
                             FontSize="20"
                             LineHeight="26"
                             VerticalAlignment="Center"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding HomeLockedVenueTitle}" />
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="dashboard-card home-minimal-card" Padding="18,16">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="6"
                      MinHeight="72">
                  <TextBlock Classes="dashboard-eyebrow" Text="历史成功次数" />
                  <TextBlock Classes="dashboard-stat-value"
                             FontSize="28"
                             Grid.Row="1"
                             VerticalAlignment="Center"
                             Text="{Binding HomeHistoricalSuccessCount}" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="dashboard-card home-minimal-card" Padding="18,16">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="6"
                      MinHeight="72">
                  <TextBlock Classes="dashboard-eyebrow" Text="累计守护时长" />
                  <TextBlock Classes="dashboard-stat-value"
                             FontSize="28"
                             Grid.Row="1"
                             VerticalAlignment="Center"
                             Text="{Binding HomeTotalGuardDurationText}" />
                </Grid>
              </Border>
            </Grid>

            <Grid>
              <Border Classes="dashboard-card home-minimal-card"
                      Background="#FFFFFF"
                      MinHeight="228"
                      Padding="22,18">
                <Grid>
                  <Grid IsVisible="{Binding HasCurrentReservation}"
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock Classes="dashboard-eyebrow"
                                 Text="当前预约"
                                 VerticalAlignment="Center" />

                      <Border Background="{Binding HomeReservationBadgeBackgroundBrush}"
                              CornerRadius="999"
                              Padding="12,6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Ellipse Width="8"
                                   Height="8"
                                   Fill="{Binding HomeReservationBadgeBrush}" />
                          <TextBlock Text="{Binding HomeReservationBadgeText}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding HomeReservationBadgeBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="144,*"
                          ColumnSpacing="18"
                          VerticalAlignment="Stretch">
                      <StackPanel Spacing="4"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Left">
                        <TextBlock Classes="dashboard-ticket-seat"
                                   MaxWidth="144"
                                   Margin="0,-10,0,0"
                                   FontSize="70"
                                   LineHeight="74"
                                   Text="{Binding HomeReservationSeatNumberText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="dashboard-ticket-caption"
                                   Text="座位号" />
                      </StackPanel>

                      <Grid Grid.Column="1"
                            ColumnDefinitions="Auto,190,190"
                            ColumnSpacing="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Border Classes="dashboard-reservation-detail"
                                MinWidth="190"
                                MaxWidth="286"
                                Padding="12">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="dashboard-reservation-icon">
                              <PathIcon Data="{StaticResource IconBuilding}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource SemiAccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Classes="dashboard-ticket-caption" Text="场馆名称" />
                              <TextBlock FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                         Text="{Binding HomeReservationVenueText}"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="dashboard-reservation-detail"
                                Padding="12">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="dashboard-reservation-icon">
                              <PathIcon Data="{StaticResource IconClock}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource SemiAccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Classes="dashboard-ticket-caption" Text="签到截止时间" />
                              <TextBlock FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                         Text="{Binding HomeReservationExpirationTimeText}"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="dashboard-reservation-detail"
                                Padding="12">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="dashboard-reservation-icon">
                              <PathIcon Data="{StaticResource IconHourglass}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource SemiAccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Classes="dashboard-ticket-caption" Text="剩余时间" />
                              <TextBlock FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                         Text="{Binding HomeReservationRemainingText}"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="16"
                          VerticalAlignment="Bottom">
                      <StackPanel Spacing="5"
                                  VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="dashboard-ticket-caption"
                                     Text="距离签到截止" />
                          <TextBlock Grid.Column="1"
                                     Classes="dashboard-ticket-caption"
                                     Text="{Binding HomeReservationRemainingText}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding HomeReservationProgressValue}"
                                     Height="7"
                                     Foreground="{Binding HomeReservationProgressBrush}"
                                     Background="{DynamicResource DashboardMutedSurfaceBrush}" />
                      </StackPanel>

                      <Button Grid.Column="1"
                              Content="取消当前预约"
                              Classes="Danger"
                              Command="{Binding CancelCurrentReservationCommand}"
                              IsEnabled="{Binding CanCancelCurrentReservation}"
                              HorizontalAlignment="Right"
                              HorizontalContentAlignment="Center"
                              MinWidth="140" />
                    </Grid>
                  </Grid>

                  <StackPanel IsVisible="{Binding HasNoCurrentReservation}"
                              Spacing="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <Border Width="54"
                            Height="54"
                            CornerRadius="27"
                            Background="{DynamicResource AppNeutralIconSurfaceBrush}"
                            BorderBrush="{DynamicResource AppNeutralIconBorderBrush}"
                            BorderThickness="1">
                      <PathIcon Data="{StaticResource IconOccupy}"
                                Width="28"
                                Height="28"
                                Foreground="{DynamicResource SemiAccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="当前暂无预约记录"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SemiTextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="去配置一个新任务吧，首页会在这里展示最新的预约状态与生效结果"
                               Classes="dashboard-detail"
                               MaxWidth="380"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Grid>
              <Border Classes="dashboard-card home-minimal-card"
                      Background="#FFFFFF"
                      MinHeight="214"
                      Padding="24,22">
                <Grid>
                  <Grid IsVisible="{Binding HasCurrentCookie}"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock Classes="dashboard-eyebrow"
                                 Text="当前Cookie"
                                 VerticalAlignment="Center" />

                      <Border Background="{Binding HomeCookieBadgeBackgroundBrush}"
                              CornerRadius="999"
                              Padding="12,6"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Ellipse Width="8"
                                   Height="8"
                                   Fill="{Binding HomeCookieBadgeBrush}" />
                          <TextBlock Text="{Binding HomeCookieBadgeText}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding HomeCookieBadgeBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                      <Border Classes="dashboard-reservation-detail">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <Border Classes="dashboard-reservation-icon">
                            <PathIcon Data="{StaticResource IconClock}"
                                      Width="18"
                                      Height="18"
                                      Foreground="{DynamicResource SemiAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="dashboard-ticket-caption" Text="Cookie到期时间" />
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                       Text="{Binding HomeCookieExpirationTimeText}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border Grid.Column="1"
                              Classes="dashboard-reservation-detail">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <Border Classes="dashboard-reservation-icon">
                            <PathIcon Data="{StaticResource IconHourglass}"
                                      Width="18"
                                      Height="18"
                                      Foreground="{DynamicResource SemiAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="dashboard-ticket-caption" Text="剩余有效时间" />
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                       Text="{Binding HomeCookieRemainingText}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Spacing="7"
                                VerticalAlignment="Bottom">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="dashboard-ticket-caption"
                                   Text="距离 Cookie 过期" />
                        <TextBlock Grid.Column="1"
                                   Classes="dashboard-ticket-caption"
                                   Text="{Binding HomeCookieRemainingText}" />
                      </Grid>
                      <ProgressBar Minimum="0"
                                   Maximum="100"
                                   Value="{Binding HomeCookieProgressValue}"
                                   Height="8"
                                   Foreground="{Binding HomeCookieProgressBrush}"
                                   Background="{DynamicResource DashboardMutedSurfaceBrush}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel IsVisible="{Binding HasNoCurrentCookie}"
                              Spacing="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <Border Width="54"
                            Height="54"
                            CornerRadius="27"
                            Background="{DynamicResource AppNeutralIconSurfaceBrush}"
                            BorderBrush="{DynamicResource AppNeutralIconBorderBrush}"
                            BorderThickness="1">
                      <PathIcon Data="{StaticResource IconEventKey}"
                                Width="28"
                                Height="28"
                                Foreground="{DynamicResource SemiAccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="当前未登录"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SemiTextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="登录后这里会显示 Cookie 到期时间、剩余有效时间与过期进度"
                               Classes="dashboard-detail"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- Tab 1: Login -->
        <ScrollViewer>
          <Grid RowDefinitions="Auto,*"
                RowSpacing="16"
                Margin="0,0,16,0"
                Background="Transparent">
            <TextBlock Classes="page-title" Text="账户与场馆" />
            <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="16" Background="Transparent">
              <Border Classes="semi-card Shadow" Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="授权"
                              FontSize="22"
                              FontWeight="Bold"
                              VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Theme="{DynamicResource TagLabel}"
                            Classes="Green"
                            IsVisible="{Binding IsAuthorized}">
                      <TextBlock Text="已授权" />
                    </Border>
                    <Border Grid.Column="2"
                            Theme="{DynamicResource TagLabel}"
                            Classes="Grey"
                            IsVisible="{Binding IsUnauthorized}">
                      <TextBlock Text="未授权" />
                    </Border>
                  </Grid>

                  <TextBlock Text="{Binding SessionSummary}" Classes="helper-text" />

                  <StackPanel Spacing="16" IsVisible="{Binding ShouldShowAuthorizationInput}">
                    <Border Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                      <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Image Source="/Assets/qrcode.png"
                              MaxWidth="208"
                              MaxHeight="208"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="微信扫一扫获取授权链接"
                                  Classes="helper-text"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="field-label" Text="授权链接" />
                      <TextBox Watermark="在此粘贴包含 code 的链接..." Text="{Binding QrLinkText}" />
                      <CheckBox Content="记住会话"
                                IsChecked="{Binding RememberSession}"
                                HorizontalAlignment="Right" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                      <Button Content="从链接解析"
                              Command="{Binding GetCookieFromLinkCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Background="{DynamicResource AppAccentBrush}"
                              Foreground="{DynamicResource AppAccentForegroundBrush}"
                              FontWeight="Bold" />
                      <Button Grid.Column="1"
                              Content="{Binding SystemSettings.CookieQuickTransferButtonText}"
                              Command="{Binding StartLanCookieRelayCommand}"
                              IsEnabled="{Binding CanStartLanCookieRelay}"
                              Classes="Secondary"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              FontWeight="SemiBold" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="12"
                              IsVisible="{Binding ShouldShowAuthorizedSummary}"
                              HorizontalAlignment="Center">
                    <TextBlock Text="✓"
                              FontSize="56"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SemiSuccessTextBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="当前已成功授权"
                              FontSize="24"
                              FontWeight="Bold"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="如需切换账号，可先注销再重新扫码授权"
                              Classes="helper-text"
                              TextAlignment="Center"
                              MaxWidth="260" />
                    <Button Content="注销授权 / 重新授权"
                            Command="{Binding SignOutCommand}"
                            Classes="Danger"
                            MinWidth="160"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center" />
                  </StackPanel>

                  <Expander IsExpanded="False">
                    <Expander.Header>
                      <TextBlock Text="高级：手动填写 Cookie" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Margin="0,16,0,0" Spacing="16">
                      <TextBox Watermark="如有需要可自行抓包并在此手动粘贴完整 Cookie..."
                              Text="{Binding ManualCookieText}"
                              Margin="0,8,0,0"
                              AcceptsReturn="True"
                              MinHeight="96"
                              TextWrapping="Wrap" />
                      <Button Content="验证有效性"
                              Command="{Binding ValidateManualCookieCommand}"
                              Classes="Secondary"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Classes="semi-card Shadow"
                      VerticalAlignment="Stretch">
                <Grid>
                  <StackPanel Spacing="16">
                    <TextBlock Text="场馆配置"
                              FontSize="22"
                              FontWeight="Bold" />
                    <TextBlock Text="通过看板切换候选场馆，再用下方操作正式锁定"
                              Classes="helper-text"
                              IsVisible="{Binding CanShowVenueConfiguration}" />

                    <Grid MinHeight="540"
                          IsVisible="{Binding IsUnauthorized}">
                      <StackPanel Spacing="12"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="{DynamicResource AppNeutralIconSurfaceBrush}"
                                BorderBrush="{DynamicResource AppNeutralIconBorderBrush}"
                                BorderThickness="1">
                          <PathIcon Data="{StaticResource IconBuilding}"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource SemiAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="当前未授权"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="授权后这里会显示场馆配置、候选场馆与锁定操作"
                                   Classes="dashboard-detail"
                                   MaxWidth="380"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <Border Padding="24,16,24,24"
                            CornerRadius="16"
                            Background="{DynamicResource SemiAccentGlowBrush}"
                            BorderBrush="{DynamicResource SemiCardBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding CanShowVenueConfiguration}">
                    <Grid ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="32"
                            RowSpacing="18">
                      <StackPanel Margin="16,8,16,16"
                                  VerticalAlignment="Center"
                                  Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                    Background="{DynamicResource SemiSuccessSoftBrush}"
                                    IsVisible="{Binding ShowVenueOpenStatusTag}">
                              <TextBlock Text="{Binding VenueStatusText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiSuccessTextBrush}" />
                            </Border>
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                    Background="{DynamicResource SemiColorFill0}"
                                    IsVisible="{Binding ShowVenueClosedStatusTag}">
                              <TextBlock Text="{Binding VenueStatusText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiColorText2}" />
                            </Border>
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                    Background="{DynamicResource SemiSuccessSoftBrush}"
                                    IsVisible="{Binding IsCurrentLocked}">
                              <TextBlock Text="{Binding CurrentVenueLockStateText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiSuccessTextBrush}" />
                            </Border>
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                    IsVisible="{Binding ShowVenuePreviewStateTag}"
                                    Background="{DynamicResource SemiWarningSoftBrush}"
                                    BorderBrush="{DynamicResource AppWarningBorderBrush}"
                                    BorderThickness="1">
                              <TextBlock Text="{Binding CurrentVenueLockStateText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource SemiWarningTextBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding VenueName}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Margin="0,4,0,0"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding VenueFloor, StringFormat=楼层 · {0}}"
                                     FontSize="14"
                                     Foreground="{DynamicResource SemiColorText2}"
                                     Margin="0,8,0,0"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="13"
                                     Foreground="{DynamicResource SemiColorText2}"
                                     Margin="0,8,0,0"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis">
                            <Run Text="开馆 · " />
                            <Run Text="{Binding VenueOpenTimeText}" />
                            <Run Text="    闭馆 · " />
                            <Run Text="{Binding VenueCloseTimeText}" />
                          </TextBlock>
                      </StackPanel>

                      <Button Grid.Column="1"
                              Grid.Row="0"
                              Command="{Binding RefreshSeatsCommand}"
                              IsVisible="{Binding IsCurrentLocked}"
                              Classes="Tertiary compact-icon"
                              Background="Transparent"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              ToolTip.Tip="刷新当前锁定场馆信息">
                        <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4V1L7 6l5 5V7c2.76 0 5 2.24 5 5 0 .65-.13 1.27-.36 1.84l1.46 1.46C18.68 14.27 19 13.17 19 12c0-2.21-.9-4.2-2.35-5.65zM6.35 17.65C7.8 19.1 9.79 20 12 20v3l5-5-5-5v4c-2.76 0-5-2.24-5-5 0-.65.13-1.27.36-1.84L5.9 8.7C5.32 9.73 5 10.83 5 12c0 2.21.9 4.2 2.35 5.65z"
                                  Width="22"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource AppAccentBrush}" />
                      </Button>

                        <StackPanel Grid.Column="1"
                                    Grid.RowSpan="2"
                                    MinWidth="132"
                                    Spacing="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                          <TextBlock Text="剩余座位"
                                    FontSize="12"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding VenueAvailableSeatsText}"
                                    FontSize="56"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AppAccentBrush}"
                                    HorizontalAlignment="Right" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    HorizontalAlignment="Left">
                          <Button Content="更换当前场馆..."
                                  Command="{Binding OpenVenuePickerCommand}"
                                  Background="{DynamicResource AppAccentSoftBrush}"
                                  BorderBrush="{DynamicResource AppAccentPanelBorderBrush}"
                                  BorderThickness="1"
                                  Foreground="{DynamicResource AppAccentBrush}"
                                  FontWeight="SemiBold"
                                  MinWidth="148"
                                  IsVisible="{Binding ShowVenueChangeButton}"
                                  HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Center" />
                          <Button Content="取消预览 (恢复原锁定)"
                                  Command="{Binding CancelVenuePreviewCommand}"
                                  Classes="Secondary"
                                  MinWidth="180"
                                  IsVisible="{Binding ShowVenueCancelPreviewButton}"
                                  IsEnabled="{Binding CanCancelVenuePreview}"
                                  HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <StackPanel IsVisible="{Binding CanShowVenueConfiguration}">
                      <Button Content="{Binding LockVenueButtonText}"
                              Command="{Binding BindSelectedLibraryCommand}"
                              MinWidth="140"
                              IsVisible="{Binding IsCurrentPreview}"
                              HorizontalAlignment="Right"
                              HorizontalContentAlignment="Center"
                              Background="{DynamicResource AppAccentBrush}"
                              Foreground="{DynamicResource AppAccentForegroundBrush}"
                              FontWeight="Bold" />
                      <Button Content="{Binding LockVenueButtonText}"
                              MinWidth="140"
                              IsVisible="{Binding IsCurrentLocked}"
                              IsEnabled="False"
                              HorizontalAlignment="Right"
                              HorizontalContentAlignment="Center"
                              Background="{DynamicResource SemiColorFill0}"
                              BorderBrush="{DynamicResource SemiCardBorderBrush}"
                              BorderThickness="1"
                              Foreground="{DynamicResource SemiColorText2}"
                              FontWeight="Bold" />
                    </StackPanel>
                  </StackPanel>

                </Grid>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>

          <!-- Tab 2: Grab -->
          <ScrollViewer x:Name="GrabPageScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
          <Grid RowDefinitions="Auto,Auto,*"
                RowSpacing="16"
                Margin="0,0,16,0"
                Background="Transparent">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="page-title"
                           Text="抢座"
                           Margin="0" />
              </StackPanel>

              <Border Grid.Column="1"
                      Padding="14,10"
                      CornerRadius="16"
                      Background="{DynamicResource SemiAccentGlowBrush}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <StackPanel Spacing="2">
                  <TextBlock Text="当前锁定场馆"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding BoundLibraryTitle}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="semi-card Shadow"
                    Padding="20">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="24">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="8">
                    <TextBlock Text="任务配置"
                               FontSize="18"
                               FontWeight="Bold" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">
                      <Button Content="🎯 选择目标座位"
                              Command="{Binding OpenGrabSeatSelectionOverlayCommand}"
                              IsEnabled="{Binding CanEditGrabConfiguration}"
                              Background="{DynamicResource AppAccentBrush}"
                              Foreground="{DynamicResource AppAccentForegroundBrush}"
                              FontWeight="Bold"
                              MinWidth="160"
                              HorizontalContentAlignment="Center"
                              VerticalAlignment="Top" />

                      <Border Grid.Column="1"
                              Background="{DynamicResource SemiColorFill0}"
                              BorderBrush="{DynamicResource SemiCardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="16"
                              Padding="12">
                        <Grid>
                          <ItemsControl ItemsSource="{Binding SelectedSeats}"
                                        IsVisible="{Binding HasSelectedSeats}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Margin="0,0,8,8"
                                        Padding="10,6"
                                        CornerRadius="999"
                                        Background="{DynamicResource SemiAccentSoftBrush}"
                                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                        BorderThickness="1">
                                  <StackPanel Orientation="Horizontal"
                                              Spacing="8">
                                    <TextBlock Text="{Binding SeatName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiAccentBrush}" />
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveSelectedSeatCommand, ElementName=MainWindowRoot}"
                                            CommandParameter="{Binding .}"
                                            Classes="chip-close"
                                            IsEnabled="{Binding DataContext.CanEditGrabConfiguration, ElementName=MainWindowRoot}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource SemiAccentBrush}"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock Text="尚未选择目标座位"
                                     Classes="helper-text"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasNoSelectedSeats}" />
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>

                  <Grid ColumnDefinitions="15*,9*,24*"
                        ColumnSpacing="16">
                    <StackPanel Spacing="0">
                      <TextBlock Text="抢座执行策略"
                                 Classes="field-label" />
                      <ComboBox SelectedIndex="{Binding SelectedGrabReservationStrategyIndex}"
                                ItemsSource="{Binding GrabReservationStrategies}"
                                IsEnabled="{Binding CanEditGrabConfiguration}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="0">
                      <TextBlock Text="抢座模式"
                                 Classes="field-label" />
                      <ComboBox SelectedIndex="{Binding SelectedGrabPollingModeIndex}"
                                ItemsSource="{Binding GrabPollingModes}"
                                IsEnabled="{Binding CanEditGrabConfiguration}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Spacing="4">
                      <TextBlock Text="定时启动"
                                 Classes="field-label" />
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">
                        <ToggleSwitch IsChecked="{Binding IsGrabScheduledStartEnabled}"
                                      OnContent="开"
                                      OffContent="关"
                                      IsEnabled="{Binding CanEditGrabConfiguration}"
                                      VerticalAlignment="Center" />
                        <TimePicker Grid.Column="1"
                                    SelectedTime="{Binding ScheduledStartTime}"
                                    UseSeconds="True"
                                    MinuteIncrement="1"
                                    SecondIncrement="1"
                                    ClockIdentifier="24HourClock"
                                    IsEnabled="{Binding CanEditGrabScheduledStartTime}"
                                    HorizontalAlignment="Stretch" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Spacing="10"
                            Width="168">
                  <TextBlock Text="执行控制"
                             Classes="field-label" />
                  <Button Content="开始监控"
                          Command="{Binding StartGrabCommand}"
                          IsEnabled="{Binding CanEditGrabConfiguration}"
                          Background="{DynamicResource AppAccentBrush}"
                          Foreground="{DynamicResource AppAccentForegroundBrush}"
                          FontWeight="Bold"
                          HorizontalContentAlignment="Center" />
                  <Button Content="停止任务"
                          Command="{Binding StopGrabCommand}"
                          IsEnabled="{Binding IsGrabTaskActive}"
                          Classes="Danger"
                          HorizontalContentAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,*"
                  RowSpacing="16">
              <Grid ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="14">
                <Border Classes="grab-stat-card Shadow">
                  <StackPanel Spacing="10">
                    <TextBlock Text="轮询总次数"
                               Classes="grab-stat-title" />
                    <TextBlock Text="{Binding GrabPollCount}"
                               Classes="grab-stat-value" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Classes="grab-stat-card Shadow">
                  <StackPanel Spacing="10">
                    <TextBlock Text="已发请求数"
                               Classes="grab-stat-title" />
                    <TextBlock Text="{Binding GrabRequestCount}"
                               Classes="grab-stat-value" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Classes="grab-stat-card Shadow">
                  <StackPanel Spacing="10">
                    <TextBlock Text="最近一次请求"
                               Classes="grab-stat-title" />
                    <TextBlock Text="{Binding GrabLastRequestText}"
                               Classes="grab-stat-value"
                               FontSize="24" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Classes="grab-stat-card Shadow">
                  <StackPanel Spacing="10">
                    <TextBlock Text="任务运行时长"
                               Classes="grab-stat-title" />
                    <TextBlock Text="{Binding GrabRuntimeText}"
                               Classes="grab-stat-value" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="1"
                      Classes="semi-card Shadow"
                      Padding="20">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="抢座实时日志"
                                 FontSize="18"
                                 FontWeight="Bold" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,6"
                            CornerRadius="999"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiCardBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding GrabDashboardStatusText}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding GrabDashboardStatusBrush}" />
                    </Border>
                  </Grid>

                  <Border Grid.Row="1"
                          Background="{DynamicResource SemiColorFill0}"
                          BorderBrush="{DynamicResource SemiCardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="18"
                          Padding="16">
                    <ScrollViewer x:Name="GrabLogScrollViewer"
                                  MinHeight="220"
                                  MaxHeight="360"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock Text="{Binding GrabLogsText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                           FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                                           FontSize="12.5" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>
          </ScrollViewer>

        <!-- Tab 3: Global Leak -->
        <ScrollViewer>
          <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="16"
                Margin="0,0,16,0"
                Background="Transparent">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="page-title"
                           Text="全域捡漏"
                           Margin="0" />
              </StackPanel>

              <Border Grid.Column="1"
                      Padding="14,10"
                      CornerRadius="16"
                      Background="{DynamicResource SemiAccentGlowBrush}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <StackPanel Spacing="2">
                  <TextBlock Text="扫描范围"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding SelectedGlobalLeakLibrarySummaryText}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Grid>

          <Border Grid.Row="1"
                  Classes="semi-card Shadow"
                  Padding="20">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="24">
              <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="任务配置"
                             FontSize="18"
                             FontWeight="Bold" />
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">
                    <Button Content="🏛️ 选择扫描场馆"
                            Command="{Binding OpenGlobalLeakLibraryPickerCommand}"
                            IsEnabled="{Binding CanEditGlobalLeakConfiguration}"
                            Background="{DynamicResource AppAccentBrush}"
                            Foreground="{DynamicResource AppAccentForegroundBrush}"
                            FontWeight="Bold"
                            MinWidth="160"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Top" />

                    <Border Grid.Column="1"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                      <Grid>
                        <ItemsControl ItemsSource="{Binding SelectedGlobalLeakLibraryPriorities}"
                                      IsVisible="{Binding HasSelectedGlobalLeakLibraries}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,8,8"
                                      Padding="10,6"
                                      CornerRadius="999"
                                      Background="{DynamicResource SemiAccentSoftBrush}"
                                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                      BorderThickness="1">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                  <TextBlock FontSize="12"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource SemiAccentBrush}">
                                    <Run Text="#" />
                                    <Run Text="{Binding Priority}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding LibraryName}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Floor}" />
                                  </TextBlock>
                                  <Button Content="✕"
                                          Command="{Binding DataContext.RemoveSelectedGlobalLeakLibraryCommand, ElementName=MainWindowRoot}"
                                          CommandParameter="{Binding Target}"
                                          Classes="chip-close"
                                          IsEnabled="{Binding DataContext.CanEditGlobalLeakConfiguration, ElementName=MainWindowRoot}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource SemiAccentBrush}"
                                          FontSize="11"
                                          FontWeight="Bold"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="尚未选择扫描场馆"
                                   Classes="helper-text"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasNoSelectedGlobalLeakLibraries}" />
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="220">
                  <StackPanel Spacing="0">
                    <TextBlock Text="扫描间隔"
                               Classes="field-label" />
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <NumericUpDown Minimum="1"
                                     Maximum="3600"
                                     Increment="1"
                                     ClipValueToMinMax="True"
                                     ParsingNumberStyle="Integer"
                                     Value="{Binding GlobalLeakScanIntervalSeconds}"
                                     FormatString="0"
                                     IsEnabled="{Binding CanEditGlobalLeakConfiguration}"
                                     TextInput="OnUnsignedIntegerNumericUpDownTextInput"
                                     KeyDown="OnUnsignedIntegerNumericUpDownKeyDown"
                                     HorizontalAlignment="Stretch" />
                      <TextBlock Grid.Column="1"
                                 Text="秒"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="10"
                          Width="168">
                <TextBlock Text="执行控制"
                           Classes="field-label" />
                <Button Content="开始捡漏"
                        Command="{Binding StartGlobalLeakCommand}"
                        IsEnabled="{Binding CanEditGlobalLeakConfiguration}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center" />
                <Button Content="停止任务"
                        Command="{Binding StopGlobalLeakCommand}"
                        IsEnabled="{Binding IsGlobalLeakTaskActive}"
                        Classes="Danger"
                        HorizontalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="2"
                RowDefinitions="Auto,*"
                RowSpacing="16">
            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="14">
              <Border Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="扫描轮次"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding GlobalLeakScanRoundCount}"
                             Classes="grab-stat-value" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="已发请求数"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding GlobalLeakRequestCount}"
                             Classes="grab-stat-value" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="最近一次请求"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding GlobalLeakLastRequestText}"
                             Classes="grab-stat-value"
                             FontSize="24" />
                </StackPanel>
              </Border>

              <Border Grid.Column="3"
                      Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="任务运行时长"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding GlobalLeakRuntimeText}"
                             Classes="grab-stat-value" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="semi-card Shadow"
                    Padding="20">
              <Grid RowDefinitions="Auto,*"
                    RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="全域捡漏实时日志"
                               FontSize="18"
                               FontWeight="Bold" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Padding="10,6"
                          CornerRadius="999"
                          Background="{DynamicResource SemiColorFill0}"
                          BorderBrush="{DynamicResource SemiCardBorderBrush}"
                          BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlobalLeakDashboardStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding GlobalLeakDashboardStatusBrush}" />
                  </Border>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                  <ScrollViewer x:Name="GlobalLeakLogScrollViewer"
                                MinHeight="220"
                                MaxHeight="360"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding GlobalLeakLogsText}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                         FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                                         FontSize="12.5" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
          </Grid>
          </Grid>
        </ScrollViewer>

        <!-- Tab 4: Tomorrow Reservation -->
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="16"
              Margin="0,0,16,0"
              Background="Transparent">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="page-title"
                         Text="明日预约"
                         Margin="0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="14,10"
                    CornerRadius="16"
                    Background="{DynamicResource SemiAccentGlowBrush}"
                    BorderBrush="{DynamicResource SemiCardBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <StackPanel Spacing="2">
                <TextBlock Text="当前锁定场馆"
                           Classes="grab-stat-title" />
                <TextBlock Text="{Binding BoundLibraryTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiTextPrimaryBrush}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="1"
                  Classes="semi-card Shadow"
                  Padding="20">
            <StackPanel Spacing="18">
              <StackPanel Spacing="8">
                <TextBlock Text="单目标座位"
                           FontSize="18"
                           FontWeight="Bold" />
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="14">
                  <Button Content="🎯 选择目标座位"
                          Command="{Binding OpenTomorrowSeatSelectionOverlayCommand}"
                          IsEnabled="{Binding CanEditTomorrowConfiguration}"
                          Background="{DynamicResource AppAccentBrush}"
                          Foreground="{DynamicResource AppAccentForegroundBrush}"
                          FontWeight="Bold"
                          MinWidth="160"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Top" />

                  <Border Grid.Column="1"
                          Background="{DynamicResource SemiColorFill0}"
                          BorderBrush="{DynamicResource SemiCardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="16"
                          Padding="12">
                    <TextBlock Text="{Binding SelectedTomorrowSeatText}"
                               Classes="helper-text"
                               VerticalAlignment="Center" />
                  </Border>

                  <Button Grid.Column="2"
                          Content="清空"
                          Command="{Binding ClearTomorrowSeatCommand}"
                          IsEnabled="{Binding CanEditTomorrowConfiguration}"
                          Classes="Secondary"
                          HorizontalContentAlignment="Center"
                          VerticalAlignment="Top" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="执行控制"
                           FontSize="18"
                           FontWeight="Bold" />
                <Grid ColumnDefinitions="240,Auto,Auto,Auto,*"
                      ColumnSpacing="12">
                <TimePicker SelectedTime="{Binding TomorrowScheduledStartTime}"
                            UseSeconds="True"
                            MinuteIncrement="1"
                            SecondIncrement="1"
                            ClockIdentifier="24HourClock"
                            IsEnabled="{Binding CanEditTomorrowConfiguration}"
                            MinWidth="240"
                            VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="开始定时预约"
                        Command="{Binding StartTomorrowReservationCommand}"
                        IsEnabled="{Binding CanEditTomorrowConfiguration}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        MinWidth="132"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="立即执行一次"
                        Command="{Binding RunTomorrowReservationNowCommand}"
                        IsEnabled="{Binding CanEditTomorrowConfiguration}"
                        Classes="Secondary"
                        MinWidth="124"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="停止任务"
                        Command="{Binding StopTomorrowReservationCommand}"
                        IsEnabled="{Binding IsTomorrowTaskActive}"
                        Classes="Danger"
                        MinWidth="112"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2"
                RowDefinitions="Auto,*"
                RowSpacing="16">
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="14">
              <Border Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="已发请求数"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding TomorrowRequestCount}"
                             Classes="grab-stat-value" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="最近一次请求"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding TomorrowLastRequestText}"
                             Classes="grab-stat-value"
                             FontSize="24" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Classes="grab-stat-card Shadow">
                <StackPanel Spacing="10">
                  <TextBlock Text="验证结果"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding TomorrowVerificationText}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="semi-card Shadow"
                    Padding="20">
              <Grid RowDefinitions="Auto,*"
                    RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <TextBlock Text="明日预约实时日志"
                             FontSize="18"
                             FontWeight="Bold" />
                  <Border Grid.Column="1"
                          Padding="10,6"
                          CornerRadius="999"
                          Background="{DynamicResource SemiColorFill0}"
                          BorderBrush="{DynamicResource SemiCardBorderBrush}"
                          BorderThickness="1"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding TomorrowDashboardStatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding TomorrowDashboardStatusBrush}" />
                  </Border>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                  <ScrollViewer x:Name="TomorrowLogScrollViewer"
                                MinHeight="220"
                                MaxHeight="360"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding TomorrowLogsText}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource SemiTextPrimaryBrush}"
                                         FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                                         FontSize="12.5" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Tab 5: Occupy -->
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="24" Margin="0,0,16,0" Background="Transparent">
          <TextBlock Classes="page-title" Text="占座" Margin="0,0,0,16" />

          <Border Grid.Row="1"
                  Classes="semi-card Shadow"
                  Background="{DynamicResource SemiCardBackgroundBrush}"
                  Padding="28">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="32" RowSpacing="20">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                <TextBlock Classes="hero-title" Text="{Binding ReservationHeroTitle}" VerticalAlignment="Center" />
                <Label Content="运行中"
                       Theme="{DynamicResource TagLabel}"
                       Classes="Green"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsOccupyRunning}" />
                <Label Content="已停止"
                       Theme="{DynamicResource TagLabel}"
                       Classes="Grey"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsOccupyStopped}" />
              </StackPanel>

              <WrapPanel Grid.Row="1"
                         Grid.Column="1"
                         Orientation="Horizontal"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom">
                <Button Content="手动刷新"
                        Command="{Binding RefreshReservationCommand}"
                        Classes="Secondary"
                        Margin="0,0,12,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Content="停止占座"
                        Command="{Binding StopOccupyCommand}"
                        Classes="Danger"
                        Margin="0,0,12,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Content="开始占座"
                        Command="{Binding StartOccupyCommand}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        Margin="0,0,12,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </WrapPanel>

              <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*" ColumnSpacing="28" VerticalAlignment="Bottom">
                <StackPanel Spacing="4">
                  <TextBlock Text="座位过期时间"
                             FontSize="12"
                             Foreground="{DynamicResource SemiColorText2}" />
                  <TextBlock Text="{Binding ReservationExpiryText}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SemiColorText0}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="取消座位预约倒计时"
                             FontSize="12"
                             Foreground="{DynamicResource SemiColorText2}" />
                  <TextBlock Text="{Binding ReservationCountdownText}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SemiColorText0}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24" Background="Transparent">
            <Border Classes="semi-card Shadow">
              <Grid RowDefinitions="Auto,*" RowSpacing="16">
                <TextBlock Classes="section-title" Text="策略设置" Margin="0" />
                <StackPanel Grid.Row="1" Spacing="20">
                  <StackPanel Spacing="0">
                    <TextBlock Classes="field-label" Text="轮询刷新频率" />
                    <ComboBox SelectedIndex="{Binding SelectedOccupyCheckIntervalModeIndex}"
                              ItemsSource="{Binding OccupyCheckIntervalModes}"
                              HorizontalAlignment="Stretch" />
                  </StackPanel>

                  <StackPanel Spacing="0">
                    <TextBlock Classes="field-label" Text="重新预约间隔时间" />
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <NumericUpDown Minimum="1"
                                     Maximum="1800"
                                     Increment="1"
                                     ClipValueToMinMax="True"
                                     ParsingNumberStyle="Integer"
                                     Value="{Binding ReReserveDelaySeconds}"
                                     FormatString="0"
                                     TextInput="OnUnsignedIntegerNumericUpDownTextInput"
                                     KeyDown="OnUnsignedIntegerNumericUpDownKeyDown"
                                     HorizontalAlignment="Stretch" />
                      <TextBlock Grid.Column="1"
                                 Text="秒"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="semi-card Shadow">
              <Grid RowDefinitions="Auto,*" RowSpacing="16">
                <TextBlock Classes="section-title" Text="占座实时日志" Margin="0" />
                <Border Grid.Row="1"
                        Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="16"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                x:Name="OccupyLogScrollViewer">
                    <ItemsControl ItemsSource="{Binding OccupyLogLines}" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Tab 6: Remote Check-In -->
        <ScrollViewer>
          <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="16"
                Margin="0,0,16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="远程签到" Margin="0" />
              </StackPanel>
              <Border Grid.Column="1"
                      Padding="14,10"
                      CornerRadius="16"
                      Background="{DynamicResource SemiAccentGlowBrush}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding RemoteCheckInPage.AuthorizationStatusText}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiTextSecondaryBrush}" />
              </Border>
            </Grid>

            <Border Grid.Row="1" Classes="semi-card Shadow" Padding="22">
              <Grid ColumnDefinitions="Auto,*,210" ColumnSpacing="20">
                <Border Background="White"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        VerticalAlignment="Center">
                  <Image Source="/Assets/qrcode.png"
                         Width="150"
                         Height="150"
                         Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                  <TextBlock Classes="section-title" Margin="0" Text="签到专用授权" />
                  <TextBlock Text="{Binding RemoteCheckInPage.AuthorizationExpirationText}"
                             Classes="helper-text"
                             TextWrapping="Wrap" />
                  <TextBox Text="{Binding RemoteCheckInPage.AuthorizationLinkText}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="104"
                           Watermark="自动读取剪贴板，也可粘贴包含 32 位 code 的新授权链接" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                  <Button Content="解析并获取授权"
                          Command="{Binding RemoteCheckInPage.AuthorizeFromLinkCommand}"
                          IsEnabled="{Binding RemoteCheckInPage.CanAuthorize}"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource AppAccentBrush}"
                          Foreground="{DynamicResource AppAccentForegroundBrush}" />
                  <Button Content="{Binding SystemSettings.RemoteCheckInQuickTransferButtonText}"
                          Command="{Binding RemoteCheckInPage.StartRemoteCheckInLanRelayCommand}"
                          IsEnabled="{Binding RemoteCheckInPage.CanAuthorize}"
                          HorizontalAlignment="Stretch"
                          Classes="Secondary" />
                  <CheckBox Content="记住签到授权"
                            IsChecked="{Binding RemoteCheckInPage.RememberRemoteCheckInSession}"
                            HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="0.78*,1.22*"
                  ColumnSpacing="16"
                  IsVisible="{Binding RemoteCheckInPage.HasRemoteCheckInSession}">
              <Border Classes="semi-card Shadow" Padding="22">
                <StackPanel Spacing="14">
                  <TextBlock Classes="section-title" Margin="0" Text="提交前置状态" />
                  <Border Classes="card" Padding="14">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="grab-stat-title" Text="锁定场馆" />
                      <TextBlock Text="{Binding RemoteCheckInPage.LockedLibraryText}"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" Padding="14">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="grab-stat-title" Text="当前预约" />
                      <TextBlock Text="{Binding RemoteCheckInPage.CurrentReservationText}"
                                 TextWrapping="Wrap"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" Padding="14">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="grab-stat-title" Text="签到账号" />
                      <TextBlock Text="{Binding RemoteCheckInPage.AccountSummaryText}"
                                 TextWrapping="Wrap"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding RemoteCheckInPage.DeviceStatusText}"
                             Classes="helper-text"
                             TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Content="刷新信标"
                            Command="{Binding RemoteCheckInPage.RefreshDevicesCommand}"
                            IsEnabled="{Binding RemoteCheckInPage.CanRefreshDevices}"
                            HorizontalAlignment="Stretch"
                            Classes="Secondary" />
                    <Button Grid.Column="1"
                            Content="清除签到授权"
                            Command="{Binding RemoteCheckInPage.ClearAuthorizationCommand}"
                            IsEnabled="{Binding RemoteCheckInPage.HasRemoteCheckInSession}"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SemiCardBorderBrush}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="semi-card Shadow" Padding="22">
                <StackPanel Spacing="14">
                  <TextBlock Classes="section-title" Margin="0" Text="当前场馆 Beacon 与位置配置" />

                  <StackPanel Spacing="7">
                    <TextBlock Classes="field-label" Text="服务端允许的 Beacon UUID" />
                    <ComboBox ItemsSource="{Binding RemoteCheckInPage.AllowedBeaconUuids}"
                              SelectedItem="{Binding RemoteCheckInPage.SelectedBeaconUuid}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="请先刷新信标" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="7">
                      <TextBlock Classes="field-label" Text="Major（0~65535）" />
                      <NumericUpDown Minimum="0"
                                     Maximum="65535"
                                     Value="{Binding RemoteCheckInPage.BeaconMajor}"
                                     HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <TextBlock Classes="field-label" Text="Minor（0~65535）" />
                      <NumericUpDown Minimum="0"
                                     Maximum="65535"
                                     Value="{Binding RemoteCheckInPage.BeaconMinor}"
                                     HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="7">
                      <TextBlock Classes="field-label" Text="GCJ-02 纬度" />
                      <NumericUpDown Minimum="-90"
                                     Maximum="90"
                                     Increment="0.000001"
                                     FormatString="0.########"
                                     Value="{Binding RemoteCheckInPage.Latitude}"
                                     HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <TextBlock Classes="field-label" Text="GCJ-02 经度" />
                      <NumericUpDown Minimum="-180"
                                     Maximum="180"
                                     Increment="0.000001"
                                     FormatString="0.########"
                                     Value="{Binding RemoteCheckInPage.Longitude}"
                                     HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding RemoteCheckInPage.ProfileStatusText}"
                               Classes="helper-text"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="保存场馆配置"
                            Command="{Binding RemoteCheckInPage.SaveProfileCommand}"
                            IsEnabled="{Binding RemoteCheckInPage.CanSaveProfile}"
                            Classes="Secondary" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="3"
                    Classes="semi-card Shadow"
                    Padding="22"
                    IsVisible="{Binding RemoteCheckInPage.HasRemoteCheckInSession}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Text="{Binding RemoteCheckInPage.LastResultText}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="立即远程签到"
                        Command="{Binding RemoteCheckInPage.SignCommand}"
                        IsEnabled="{Binding RemoteCheckInPage.CanSign}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        MinWidth="180"
                        MinHeight="46"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- Tab 7: Mobile Control -->
        <ScrollViewer>
          <Grid RowDefinitions="Auto,Auto"
                RowSpacing="16"
                Margin="0,0,16,0"
                Background="Transparent">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
              <TextBlock Classes="page-title"
                         Text="手机控制"
                         Margin="0" />

              <Border Grid.Column="1"
                      Padding="14,10"
                      CornerRadius="16"
                      Background="{DynamicResource SemiAccentGlowBrush}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      VerticalAlignment="Center">
                <StackPanel Spacing="2">
                  <TextBlock Text="服务状态"
                             Classes="grab-stat-title" />
                  <TextBlock Text="{Binding MobileControlStatusText}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="12"
                  MinHeight="640">
                <Grid ColumnDefinitions="1.45*,0.9*"
                      ColumnSpacing="18"
                      Height="560">
                  <Border Classes="semi-card Shadow"
                          VerticalAlignment="Stretch"
                          Padding="24">
                    <Grid RowDefinitions="*,Auto"
                          RowSpacing="14">
                      <Grid>
                        <StackPanel Spacing="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasMobileControlQrCode}">
                          <Border Background="White"
                                  CornerRadius="18"
                                  Padding="20"
                                  BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                  BorderThickness="1">
                            <Image Source="{Binding MobileControlQrCode}"
                                   Width="300"
                                   Height="300"
                                   Stretch="Uniform" />
                          </Border>
                        </StackPanel>

                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasNoMobileControlQrCode}">
                          <Border Width="72"
                                  Height="72"
                                  CornerRadius="36"
                                  Background="{DynamicResource AppNeutralIconSurfaceBrush}"
                                  BorderBrush="{DynamicResource AppNeutralIconBorderBrush}"
                                  BorderThickness="1">
                            <PathIcon Data="M17 1H7C5.9 1 5 1.9 5 3v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 17H7V4h10v14zm-3 3h-4v-1h4v1z"
                                      Width="34"
                                      Height="34"
                                      Foreground="{DynamicResource SemiAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="手机控制尚未启动"
                                     FontSize="20"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </Grid>

                      <Border Grid.Row="1"
                              Background="{DynamicResource SemiCardBackgroundBrush}"
                              BorderBrush="{DynamicResource SemiCardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="14"
                              Padding="14">
                        <SelectableTextBlock Text="{Binding MobileControlUrlText}"
                                             FontSize="13"
                                             TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             HorizontalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1"
                          Classes="semi-card Shadow"
                          VerticalAlignment="Stretch"
                          Padding="22">
                    <Grid RowDefinitions="Auto,1,Auto,1,Auto"
                          RowSpacing="18"
                          VerticalAlignment="Center">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                          <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zM8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13z"
                                    Width="14"
                                    Height="14"
                                    Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                    VerticalAlignment="Center" />
                          <TextBlock Text="连接设备"
                                     Classes="grab-stat-title"
                                     Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MobileControlConnectedDeviceCountText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Border Grid.Row="1"
                              Height="1"
                              Background="{DynamicResource SemiCardBorderBrush}" />

                      <StackPanel Grid.Row="2"
                                  Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                          <PathIcon Data="M8 3h8v4h-2V5h-4v2H8V3zm4 5a4 4 0 0 1 4 4v1h3v-2h2v6h-2v-2h-3v1a4 4 0 0 1-8 0v-1H5v2H3v-6h2v2h3v-1a4 4 0 0 1 4-4zm-2 4v4a2 2 0 0 0 4 0v-4a2 2 0 0 0-4 0z"
                                    Width="14"
                                    Height="14"
                                    Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                    VerticalAlignment="Center" />
                          <TextBlock Text="端口"
                                     Classes="grab-stat-title"
                                     Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MobileControlPort}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                      </StackPanel>

                      <Border Grid.Row="3"
                              Height="1"
                              Background="{DynamicResource SemiCardBorderBrush}" />

                      <StackPanel Grid.Row="4"
                                  Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                          <PathIcon Data="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm-3 8V6a3 3 0 0 1 6 0v3H9zm3 4a2 2 0 0 1 1 3.73V19h-2v-2.27A2 2 0 0 1 12 13z"
                                    Width="14"
                                    Height="14"
                                    Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                    VerticalAlignment="Center" />
                          <TextBlock Text="访问令牌"
                                     Classes="grab-stat-title"
                                     Margin="0" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding MobileControlAccessTokenFullText}"
                                             FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                                             FontSize="18"
                                             TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="12"
                      Margin="0,8,0,0">
                  <Button x:Name="MobileControlToggleButton"
                          Command="{Binding ToggleMobileControlCommand}"
                          Background="{DynamicResource AppAccentBrush}"
                          Foreground="{DynamicResource AppAccentForegroundBrush}"
                          FontWeight="Bold"
                          MinWidth="160"
                          HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <PathIcon x:Name="MobileControlStartingSpinner"
                                Width="16"
                                Height="16"
                                Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z"
                                IsVisible="{Binding IsMobileControlStarting}"
                                RenderTransformOrigin="50%,50%"
                                VerticalAlignment="Center">
                        <PathIcon.RenderTransform>
                          <RotateTransform />
                        </PathIcon.RenderTransform>
                        <PathIcon.Styles>
                          <Style Selector="PathIcon">
                            <Style.Animations>
                              <Animation Duration="0:0:0.8"
                                         IterationCount="INFINITE">
                                <KeyFrame Cue="0%">
                                  <Setter Property="RotateTransform.Angle" Value="0" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="RotateTransform.Angle" Value="360" />
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </PathIcon.Styles>
                      </PathIcon>
                      <TextBlock x:Name="MobileControlToggleButtonTextBlock"
                                 Text="{Binding MobileControlToggleButtonText}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1"
                          Content="服务详情"
                          Command="{Binding OpenMobileControlDetailsCommand}"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          Foreground="{DynamicResource SemiAccentBrush}"
                          FontWeight="SemiBold"
                          HorizontalContentAlignment="Center" />
                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock Text="自动开启"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding IsMobileControlAutoStartEnabled}"
                                  OnContent=""
                                  OffContent=""
                                  Width="40"
                                  MinWidth="0"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Grid>
          </Grid>
        </ScrollViewer>

        <!-- Tab 8: Notification Settings -->
        <ScrollViewer>
          <Grid RowDefinitions="Auto,*"
                RowSpacing="18"
                Margin="0,0,16,0"
                HorizontalAlignment="Stretch">
            <TextBlock Classes="page-title" Text="通知设置" Margin="0" />

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="18">
              <primitives:TabStrip Classes="settings-center-tabs"
                                   ItemsSource="{Binding NotificationSettingsCategories}"
                                   SelectedIndex="{Binding SelectedNotificationSettingsTabIndex}"
                                   HorizontalAlignment="Left" />

              <Border Grid.Row="1"
                      Classes="semi-card Shadow">
                <Carousel SelectedIndex="{Binding SelectedNotificationSettingsTabIndex}"
                          HorizontalAlignment="Stretch">
                    <Carousel.PageTransition>
                      <CrossFade Duration="0:0:0.22" />
                    </Carousel.PageTransition>

                    <Grid HorizontalAlignment="Stretch">
                      <StackPanel Spacing="14"
                                  HorizontalAlignment="Stretch">
                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconClock}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="Cookie 即将到期提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="当前 Cookie 剩余有效期进入 10 分钟时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding CookieExpiringAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconEventKey}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="Cookie 失效提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="微信授权凭证到期、被下线或接口返回未登录时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding SessionInvalidAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconGrab}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="抢座成功提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="抢座任务成功预约到目标座位时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding GrabSucceededAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconOccupy}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="占座成功提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="占座任务完成取消并重新预约后通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding OccupyReReserveSucceededAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="明日预约成功提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="明日预约提交成功并完成结果记录时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding TomorrowReservationSucceededAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="M9.5 3a6.5 6.5 0 0 1 5.17 10.43l4.45 4.45-1.41 1.41-4.45-4.45A6.5 6.5 0 1 1 9.5 3zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zm9.5-1h2v5h-2V4zm0 7h2v2h-2v-2z"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="全域捡漏成功提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="全域捡漏扫描到空座并预约成功时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding GlobalLeakSucceededAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border Padding="12,8">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconEventFailure}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="任务失败提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="抢座、占座、明日预约或全域捡漏发生非凭证类异常时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding TaskFailedAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Border x:Name="CloudflareTunnelInterruptedAlertCard"
                                Padding="12,8"
                                IsVisible="{Binding SystemSettings.IsCloudflareTunnelSelected}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Data="{StaticResource IconEventFailure}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource SemiTextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="Cloudflare Tunnel 运行中断提醒" />
                              <TextBlock FontSize="12"
                                         Foreground="{DynamicResource SemiTextTertiaryBrush}"
                                         TextWrapping="Wrap"
                                         Text="手机控制使用 Cloudflare Tunnel 并在成功运行后突发中断时通知" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding CloudflareTunnelInterruptedAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Grid>

                    <Grid HorizontalAlignment="Stretch">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*,*"
                            RowSpacing="18"
                            ColumnSpacing="24"
                            HorizontalAlignment="Stretch">
                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="SMTP 服务器地址（主机名）" />
                          <TextBox Text="{Binding EmailAlertSmtpHost}"
                                   Watermark="smtp.example.com"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="端口" />
                        <NumericUpDown Minimum="1"
                                       Maximum="65535"
                                       Increment="1"
                                       ClipValueToMinMax="True"
                                       ParsingNumberStyle="Integer"
                                       Value="{Binding EmailAlertSmtpPort}"
                                       FormatString="0"
                                       TextInput="OnUnsignedIntegerNumericUpDownTextInput"
                                       KeyDown="OnUnsignedIntegerNumericUpDownKeyDown"
                                       HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="安全性" />
                        <ComboBox ItemsSource="{Binding EmailSecurityModes}"
                                  SelectedIndex="{Binding SelectedEmailAlertSecurityModeIndex}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.Column="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="用户名" />
                        <TextBox Text="{Binding EmailAlertUsername}"
                                 Watermark="填写 SMTP 用户名"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.Column="1"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="邮箱授权码/密码" />
                        <TextBox Text="{Binding EmailAlertPassword}"
                                 PasswordChar="●"
                                 Watermark="填写邮箱授权码或密码"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="3"
                                  Grid.Column="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="发信人邮箱地址" />
                        <TextBox Text="{Binding EmailAlertFromAddress}"
                                 Watermark="sender@example.com"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="3"
                                  Grid.Column="1"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="收信人邮箱地址" />
                        <TextBox Text="{Binding EmailAlertToAddress}"
                                 Watermark="receiver@example.com"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <Grid Grid.Row="4"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="开启邮件提醒" />
                              <TextBlock Classes="helper-text"
                                         Text="Cookie 即将到期、Cookie 失效、抢座成功或任务失败时，会自动按上方 SMTP 参数向目标邮箱发送提醒邮件" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding EmailAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试邮件"
                                Command="{Binding SendTestEmailAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="160" />
                      </Grid>
                    </Grid>
                  </Grid>

                  <Grid HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="18"
                          HorizontalAlignment="Stretch">
                      <StackPanel Grid.Row="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="Telegram API 基础地址" />
                        <TextBox Text="{Binding TelegramAlertApiBaseUrl}"
                                 Watermark="https://api.telegram.org"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="24">
                        <StackPanel Grid.Column="0"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="Bot Token" />
                          <TextBox Text="{Binding TelegramAlertBotToken}"
                                   PasswordChar="●"
                                   Watermark="123456:ABC-DEF..."
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="Chat ID" />
                          <TextBox Text="{Binding TelegramAlertChatId}"
                                   Watermark="123456789 或 @channel"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <Grid Grid.Row="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="开启 Telegram 提醒" />
                              <TextBlock Classes="helper-text"
                                         Text="Cookie 即将到期、Cookie 失效、抢座成功或任务失败时，会通过 Telegram Bot 向指定 Chat ID 发送文本提醒" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding TelegramAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试 Telegram"
                                Command="{Binding SendTestTelegramAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="176" />
                      </Grid>
                    </Grid>
                  </Grid>

                  <Grid HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="18"
                          HorizontalAlignment="Stretch">
                      <StackPanel Grid.Row="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="Server酱 SendKey" />
                        <TextBox Text="{Binding ServerChanAlertSendKey}"
                                 PasswordChar="●"
                                 Watermark="从 Server酱 SendKey 页面复制"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="24">
                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                          <TextBlock Classes="field-label"
                                     Text="消息通道 channel" />
                          <TextBox Text="{Binding ServerChanAlertChannel}"
                                   Watermark="例如 9|66，留空使用网站默认通道"
                                   HorizontalAlignment="Stretch" />
                          <TextBlock Classes="helper-text"
                                     Text="最多两个数字通道，多个通道用竖线 | 分隔" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                          <TextBlock Classes="field-label"
                                     Text="抄送 openid / UID" />
                          <TextBox Text="{Binding ServerChanAlertOpenId}"
                                   Watermark="测试号 openid 或企业微信 UID，留空发送给默认接收人"
                                   HorizontalAlignment="Stretch" />
                          <TextBlock Classes="helper-text"
                                     Text="按 Server酱通道规则填写，多个接收人使用对应分隔符" />
                        </StackPanel>
                      </Grid>

                      <Border Grid.Row="2"
                              Classes="notify-toggle-card">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="隐藏调用 IP" />
                            <TextBlock Classes="helper-text"
                                       Text="开启后本次推送会传递 noip=1，请求来源 IP 不展示在消息里" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1"
                                        IsChecked="{Binding ServerChanAlertNoIp}"
                                        OnContent="开"
                                        OffContent="关"
                                        VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Grid Grid.Row="3"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="开启 Server酱 推送" />
                              <TextBlock Classes="helper-text"
                                         Text="Cookie 即将到期、Cookie 失效、抢座成功或任务失败时，会通过 Server酱 向配置的微信、企业微信或群机器人通道发送提醒" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ServerChanAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试 Server酱"
                                Command="{Binding SendTestServerChanAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="184" />
                      </Grid>
                    </Grid>
                  </Grid>

                  <Grid HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="18"
                          HorizontalAlignment="Stretch">
                      <StackPanel Grid.Row="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="WxPusher API 基础地址" />
                        <TextBox Text="{Binding WxPusherAlertApiBaseUrl}"
                                 Watermark="https://wxpusher.zjiecode.com"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="AppToken" />
                        <TextBox Text="{Binding WxPusherAlertAppToken}"
                                 PasswordChar="●"
                                 Watermark="AT_xxx"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <Grid Grid.Row="2"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="24">
                        <StackPanel Grid.Column="0"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="UID 列表" />
                          <TextBox Text="{Binding WxPusherAlertUids}"
                                   Watermark="UID_xxx，多个可用逗号、分号或换行分隔"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="88"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="Topic ID 列表" />
                          <TextBox Text="{Binding WxPusherAlertTopicIds}"
                                   Watermark="123，多个可用逗号、分号或换行分隔"
                                   AcceptsReturn="True"
                                   TextWrapping="Wrap"
                                   MinHeight="88"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <Grid Grid.Row="3"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="开启 WxPusher 推送" />
                              <TextBlock Classes="helper-text"
                                         Text="Cookie 即将到期、Cookie 失效、抢座成功或任务失败时，会通过 WxPusher 标准推送发送到指定 UID 或 Topic" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding WxPusherAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试 WxPusher"
                                Command="{Binding SendTestWxPusherAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="184" />
                      </Grid>
                    </Grid>
                  </Grid>

                  <Grid HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="18"
                          HorizontalAlignment="Stretch">
                      <StackPanel Grid.Row="0"
                                  Spacing="0">
                        <TextBlock Classes="field-label"
                                   Text="Bark 服务端地址" />
                        <TextBox Text="{Binding BarkAlertApiBaseUrl}"
                                 Watermark="https://api.day.app"
                                 HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="24">
                        <StackPanel Grid.Column="0"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="Device Key" />
                          <TextBox Text="{Binding BarkAlertDeviceKey}"
                                   PasswordChar="●"
                                   Watermark="从 Bark App 测试 URL 中复制"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="通知级别" />
                          <ComboBox ItemsSource="{Binding BarkAlertLevels}"
                                    SelectedIndex="{Binding SelectedBarkAlertLevelIndex}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <Grid Grid.Row="2"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="24">
                        <StackPanel Grid.Column="0"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="分组" />
                          <TextBox Text="{Binding BarkAlertGroup}"
                                   Watermark="IGoLibrary-Ex"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="0">
                          <TextBlock Classes="field-label"
                                     Text="铃声" />
                          <TextBox Text="{Binding BarkAlertSound}"
                                   Watermark="alarm"
                                   HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <Grid Grid.Row="3"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                              <TextBlock FontSize="15"
                                         FontWeight="SemiBold"
                                         Text="开启 Bark 推送" />
                              <TextBlock Classes="helper-text"
                                         Text="Cookie 即将到期、Cookie 失效、抢座成功或任务失败时，会通过 Bark 向绑定 iPhone 发送推送提醒" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding BarkAlertsEnabled}"
                                          OnContent="开"
                                          OffContent="关"
                                          VerticalAlignment="Center" />
                          </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试 Bark"
                                Command="{Binding SendTestBarkAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="160" />
                      </Grid>
                    </Grid>
                  </Grid>

                  <Grid HorizontalAlignment="Stretch">
                    <StackPanel Spacing="18"
                                HorizontalAlignment="Stretch">
                      <Border Classes="notify-toggle-card">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="开启屏幕右下角通知" />
                            <TextBlock Classes="helper-text"
                                       Text="当检测到 Cookie 即将到期、Cookie 已失效、抢座成功或任务失败时，使用 Toast 弹窗形式，在屏幕右下角弹出提醒。即使你正在浏览其他网页，也能看到这一角的弹窗" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1"
                                        IsChecked="{Binding LocalToastAlertsEnabled}"
                                        OnContent="开"
                                        OffContent="关"
                                        VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Border Classes="notify-toggle-card">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="开启提示音" />
                            <TextBlock Classes="helper-text"
                                       Text="开启后，Toast 弹窗在弹出时会同时播放提示音，用于在后台工作时更快感知抢座结果、任务失败、Cookie 即将到期或 Cookie 失效" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1"
                                        IsChecked="{Binding LocalSoundAlertsEnabled}"
                                        OnContent="开"
                                        OffContent="关"
                                        VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="16"
                            Margin="0,8,0,0">
                        <Border Classes="notify-toggle-card">
                          <StackPanel Spacing="6">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="发送测试通知" />
                            <TextBlock Classes="helper-text"
                                       Text="点击后立即在屏幕右下角弹出自定义 Toast" />
                          </StackPanel>
                        </Border>

                        <Button Grid.Column="1"
                                Content="发送测试通知"
                                Command="{Binding SendTestLocalAlertCommand}"
                                Background="{DynamicResource SemiAccentBrush}"
                                Foreground="{DynamicResource AppAccentForegroundBrush}"
                                MinWidth="160" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Carousel>
            </Border>
            </Grid>
          </Grid>
        </ScrollViewer>

        <!-- Tab 9: Settings -->
        <Grid RowDefinitions="Auto,*"
              RowSpacing="18"
              Margin="0,0,16,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="page-title"
                       Margin="0"
                       Text="系统设置" />
          </StackPanel>

          <Grid Grid.Row="1"
                RowDefinitions="Auto,*"
                MinHeight="560">
            <primitives:TabStrip Classes="settings-center-tabs"
                                 ItemsSource="{Binding SystemSettingsCategories}"
                                 SelectedIndex="{Binding SelectedSystemSettingsCategoryIndex}"
                                 HorizontalAlignment="Left" />

            <Carousel Grid.Row="1"
                      SelectedIndex="{Binding SelectedSystemSettingsCategoryIndex}">
              <Carousel.PageTransition>
                <CrossFade Duration="0:0:0.22" />
              </Carousel.PageTransition>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,18,12,0">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="任务进行时关闭窗口最小化到托盘" />
                        <TextBlock Classes="helper-text"
                                   Text="有抢座、占座、明日预约或全域捡漏任务运行时，点击右下角关闭按钮后保持后台运行" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1"
                                    IsChecked="{Binding MinimizeToTrayEnabled}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="开机跟随系统自动启动" />
                        <TextBlock Classes="helper-text"
                                   Text="启用后系统开机时自动启动本程序；停用后移除已注册的开机启动项" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1"
                                    IsChecked="{Binding LaunchOnStartupEnabled}"
                                    IsEnabled="{Binding LaunchOnStartupSupported}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="最优抢座策略提醒" />
                        <TextBlock Classes="helper-text"
                                   Text="直接发送预约请求且选中 6 个及以上座位时，启动前提示切换至更高效的策略" />
                      </StackPanel>
                      <ToggleSwitch x:Name="OptimalGrabStrategyReminderToggle"
                                    Grid.Column="1"
                                    IsChecked="{Binding SystemSettings.OptimalGrabStrategyReminderEnabled}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="14">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="16">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="15"
                                     FontWeight="SemiBold"
                                     Text="自动退座" />
                          <TextBlock Classes="helper-text"
                                     Text="启用后会在当前预约到期前指定秒数自动取消预约；占座运行时会自动暂停" />
                          <TextBlock Classes="helper-text"
                                     Text="{Binding AutoReleaseStatusText}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding AutoReleaseReservationEnabled}"
                                      OnContent="开"
                                      OffContent="关"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="Auto,160"
                            ColumnSpacing="12">
                        <TextBlock Classes="field-label"
                                   Text="提前取消预约秒数"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1"
                                       Maximum="3600"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding AutoReleaseLeadSeconds}"
                                       HorizontalAlignment="Stretch" />
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,18,12,0">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="20">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="field-label"
                                   Text="界面主题" />
                        <ComboBox ItemsSource="{Binding ThemeModes}"
                                  SelectedIndex="{Binding SelectedAppThemeModeIndex}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Classes="field-label"
                                   Text="强调色来源" />
                        <CheckBox Content="启用系统强调色来源"
                                  IsChecked="{Binding UseSystemAccent}" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="20">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="记忆窗口大小" />
                        <TextBlock Classes="helper-text"
                                   Text="启用后会记录手动调整后的窗口大小，并在下次启动时恢复" />
                      </StackPanel>
                      <ToggleSwitch x:Name="RememberWindowSizeToggle"
                                    Grid.Column="1"
                                    IsChecked="{Binding SystemSettings.RememberWindowSizeEnabled}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="14">
                      <Grid ColumnDefinitions="*,260"
                            ColumnSpacing="20">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="15"
                                     FontWeight="SemiBold"
                                     Text="首页预约进度条计时逻辑" />
                          <TextBlock Classes="helper-text"
                                     Text="控制当前预约卡片底部进度条的倒退方式" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding HomeReservationProgressTimingModes}"
                                  SelectedIndex="{Binding SelectedHomeReservationProgressTimingModeIndex}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,160"
                            ColumnSpacing="20"
                            IsVisible="{Binding IsHomeReservationFixedProgressMode}">
                        <TextBlock Classes="field-label"
                                   Text="预约到期时间（分钟）"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1"
                                       Maximum="180"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding HomeReservationFixedDurationMinutes}"
                                       HorizontalAlignment="Stretch" />
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="14">
                      <Grid ColumnDefinitions="*,260"
                            ColumnSpacing="20">
                        <StackPanel Spacing="6">
                          <TextBlock FontSize="15"
                                     FontWeight="SemiBold"
                                     Text="首页Cookie进度条计时逻辑" />
                          <TextBlock Classes="helper-text"
                                     Text="控制当前Cookie卡片底部进度条的倒退方式" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding HomeCookieProgressTimingModes}"
                                  SelectedIndex="{Binding SelectedHomeCookieProgressTimingModeIndex}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,160"
                            ColumnSpacing="20"
                            IsVisible="{Binding IsHomeCookieFixedProgressMode}">
                        <TextBlock Classes="field-label"
                                   Text="Cookie有效时间（分钟）"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1"
                                       Maximum="1440"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding HomeCookieFixedDurationMinutes}"
                                       HorizontalAlignment="Stretch" />
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,18,12,0">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="20">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="field-label"
                                   Text="网络 API 超时阈值（秒）" />
                        <NumericUpDown Minimum="3"
                                       Maximum="60"
                                       Value="{Binding RequestTimeoutSeconds}"
                                       HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="8">
                        <TextBlock Classes="field-label"
                                   Text="瞬时失败重试次数（次）" />
                        <NumericUpDown Minimum="0"
                                       Maximum="10"
                                       Value="{Binding NetworkMaxRetries}"
                                       HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,280"
                          ColumnSpacing="20">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="field-label"
                                   Text="手机控制网络方式" />
                        <TextBlock Classes="helper-text"
                                   Text="控制 Cookie 快传、签到授权快传和手机控制页面使用的访问地址" />
                      </StackPanel>
                      <ComboBox Grid.Column="1"
                                ItemsSource="{Binding SystemSettings.MobileControlNetworkModes}"
                                SelectedIndex="{Binding SystemSettings.SelectedMobileControlNetworkModeIndex}"
                                IsEnabled="{Binding !SystemSettings.IsChangingMobileControlNetworkMode}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card"
                          IsVisible="{Binding SystemSettings.IsCloudflareTunnelSelected}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="20">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="field-label"
                                   Text="Tunnel 故障时回退到本机局域网" />
                        <TextBlock Classes="helper-text"
                                   Text="开启后，Cloudflare Tunnel 启动失败或运行中断时会自动改用局域网地址。关闭后将保持 Tunnel 模式并报告错误，不会降级" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1"
                                    IsChecked="{Binding SystemSettings.FallbackToLocalNetworkOnTunnelFailure}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card"
                          IsVisible="{Binding SystemSettings.IsCloudflareTunnelSelected}">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,280"
                            ColumnSpacing="20">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="field-label"
                                     Text="Cloudflare Tunnel 代理方式" />
                          <TextBlock Classes="helper-text"
                                     Text="自动模式会读取系统 HTTP 代理。Tunnel 数据连接使用 HTTP2 并继续由 TUN 或本机网络承载，TUN 分流规则仍由代理软件控制" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SystemSettings.CloudflareTunnelProxyModes}"
                                  SelectedIndex="{Binding SystemSettings.SelectedCloudflareTunnelProxyModeIndex}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,280"
                            ColumnSpacing="20"
                            IsVisible="{Binding SystemSettings.IsManualCloudflareTunnelProxy}">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="field-label"
                                     Text="手动 HTTP 代理地址" />
                          <TextBlock Classes="helper-text"
                                     Text="例如 Clash/Mihomo Mixed Port：http://127.0.0.1:7897；不支持在地址中保存账号密码" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SystemSettings.CloudflareTunnelManualProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="http://127.0.0.1:7897"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
                      </Grid>

                      <Button HorizontalAlignment="Right"
                              Classes="accent"
                              Command="{Binding SystemSettings.ApplyCloudflareTunnelProxySettingsCommand}"
                              Content="应用代理设置" />
                    </StackPanel>
                  </Border>

                  <Border Classes="card"
                          IsVisible="{Binding SystemSettings.IsCloudflareTunnelSelected}">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="20">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="field-label"
                                     Text="Clash/Mihomo 兼容模式" />
                          <TextBlock Classes="helper-text"
                                     Text="通过 Mihomo 标准本机控制接口临时加载 Cloudflare Tunnel 专用规则，当关闭 Tunnel 时自动撤销临时更改" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding SystemSettings.ClashMihomoCompatibilityEnabled}"
                                      OnContent="开"
                                      OffContent="关"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,280"
                            ColumnSpacing="20"
                            IsVisible="{Binding SystemSettings.ClashMihomoCompatibilityEnabled}">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="field-label"
                                     Text="活动配置文件（可选）" />
                          <TextBlock Classes="helper-text"
                                     Text="留空会自动发现常见客户端。其他客户端请填写包含 rules，以及 external-controller 或 Windows external-controller-pipe 的绝对 YAML 路径" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SystemSettings.ClashMihomoConfigPath, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="留空自动发现，或填写 config.yaml"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,280"
                            ColumnSpacing="20"
                            IsVisible="{Binding SystemSettings.ClashMihomoCompatibilityEnabled}">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="field-label"
                                     Text="Cloudflare 路由策略" />
                          <TextBlock Classes="helper-text"
                                     Text="填写 DIRECT，或活动配置中已有的策略组名称" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SystemSettings.ClashMihomoRoutePolicy, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="DIRECT"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
                      </Grid>

                      <Button HorizontalAlignment="Right"
                              Classes="accent"
                              Command="{Binding SystemSettings.ApplyClashMihomoCompatibilitySettingsCommand}"
                              Content="应用兼容设置" />
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                    Text="TraceInt 协议覆盖" />
                        <TextBlock Classes="helper-text"
                                    Text="启用后会使用下方地址、来源头和查询模板覆盖内置协议，适合学校自建、反向代理或接口变体场景" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1"
                                    IsChecked="{Binding TraceIntGraphQlOverridesEnabled}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <Border Classes="card"
                          IsVisible="{Binding TraceIntGraphQlOverridesEnabled}"
                          BorderBrush="{DynamicResource AppWarningBorderBrush}">
                      <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="section-title"
                                     Margin="0"
                                     Text="模板填写"
                                     Foreground="{DynamicResource SemiWarningTextBrush}" />
                          <TextBlock Classes="helper-text"
                                     Text="模板内容会在停止输入后自动保存到本地数据库" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                          <Button Content="立即保存"
                                  Command="{Binding SaveProtocolOverridesCommand}"
                                  HorizontalContentAlignment="Center"
                                  VerticalAlignment="Center" />
                          <Button Content="恢复默认"
                                  Command="{Binding ResetProtocolOverridesCommand}"
                                  Classes="Secondary"
                                  HorizontalContentAlignment="Center"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>

                      <Border IsVisible="{Binding HasProtocolValidationErrors}"
                              Padding="12"
                              CornerRadius="8"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource AppWarningBorderBrush}">
                        <TextBlock Text="{Binding ProtocolValidationSummaryText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiWarningTextBrush}" />
                      </Border>

                      <Border IsVisible="{Binding HasProtocolValidationWarnings}"
                              Padding="12"
                              CornerRadius="8"
                              Background="{DynamicResource SemiColorFill0}">
                        <TextBlock Text="{Binding ProtocolValidationWarningText}"
                                   TextWrapping="Wrap"
                                   Classes="helper-text" />
                      </Border>

                      <StackPanel Spacing="16">
                        <TextBlock Classes="section-title" Margin="0" Text="请求端点" />

                        <TextBlock Text="获取 Cookie 地址模板（ReplaceMeByCode、ReplaceMeByReturnUrl）" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GetCookieTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="GraphQL 接口地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GraphQlEndpointUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约排队 WebSocket 地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TomorrowReservationQueueUrlTemplateText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到授权地址模板（ReplaceMeByCode、ReplaceMeByReturnUrl）" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInAuthUrlTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到设备接口地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInDevicesEndpointUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到服务器时间接口地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInTimeEndpointUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到提交接口地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInSignEndpointUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Classes="section-title" Margin="0,8,0,0" Text="来源与回调" />

                        <TextBlock Text="Cookie 授权回调地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CookieAuthorizationReturnUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="普通 GraphQL Referer" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GraphQlDefaultRefererUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="普通 GraphQL Origin" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GraphQlDefaultOriginUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约 GraphQL Referer" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GraphQlTomorrowRefererUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约 GraphQL / WebSocket Origin" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding GraphQlTomorrowOriginUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到授权回调地址" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInAuthorizationReturnUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到授权 Referer" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInAuthRefererUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="远程签到 API Referer" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding RemoteCheckInApiRefererUrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Classes="section-title" Margin="0,8,0,0" Text="GraphQL 请求模板" />

                        <TextBlock Text="列出所有可用场馆模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding QueryLibrariesTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="获取指定场馆所有座位信息模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding QueryLibraryLayoutTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="查询指定场馆规则模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding QueryLibraryRuleTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="获取当前预约信息模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding QueryReservationInfoTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="预约指定座位模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ReserveSeatTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="取消当前预约模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CancelReservationTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约预热模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TomorrowReservationWarmUpTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约保存模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TomorrowReservationSaveTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>

                        <TextBlock Text="明日预约结果验证模板" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TomorrowReservationInfoTemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,18,12,0">
                  <Border Classes="card">
                    <StackPanel Spacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="日志管理" />
                        <TextBlock Classes="helper-text"
                                   Text="每次运行使用一份独立日志" />
                      </StackPanel>

                      <Grid RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*,160"
                            RowSpacing="12"
                            ColumnSpacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="field-label"
                                     Text="记录运行日志" />
                          <TextBlock Classes="helper-text"
                                     Text="更改后立即保存并应用到当前运行" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding SystemSettings.StorageSettings.IsFileLoggingEnabled}"
                                      OnContent="开"
                                      OffContent="关"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />

                        <StackPanel Grid.Row="1"
                                    Spacing="4">
                          <TextBlock Classes="field-label"
                                     Text="最多保留日志" />
                          <TextBlock Classes="helper-text"
                                     Text="调小数量后会立即清理最旧的运行日志" />
                        </StackPanel>
                        <NumericUpDown Grid.Row="1"
                                       Grid.Column="1"
                                       Minimum="1"
                                       Maximum="365"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding SystemSettings.StorageSettings.RetainedLogFileCount}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="存储位置" />
                        <TextBlock Classes="helper-text"
                                   Text="数据和日志目录会在重启后生效；应用前可选择是否迁移现有文件" />
                      </StackPanel>

                      <Grid RowDefinitions="Auto,Auto,Auto"
                            ColumnDefinitions="140,*,Auto,Auto"
                            RowSpacing="12"
                            ColumnSpacing="10">
                        <TextBlock Classes="field-label"
                                   Text="数据存储位置"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SystemSettings.StorageSettings.PendingDataDirectory}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2"
                                Command="{Binding SystemSettings.StorageSettings.SelectDataDirectoryCommand}"
                                Classes="Tertiary storage-text-action"
                                ToolTip.Tip="选择数据存储文件夹">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolderOpen}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Text="选择文件夹"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding SystemSettings.StorageSettings.RestoreDefaultDataDirectoryCommand}"
                                Classes="Tertiary storage-text-action"
                                ToolTip.Tip="恢复默认数据存储位置">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRestore}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Text="恢复默认"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="1"
                                   Classes="field-label"
                                   Text="日志文件位置"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding SystemSettings.StorageSettings.PendingLogDirectory}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 HorizontalAlignment="Stretch" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Command="{Binding SystemSettings.StorageSettings.SelectLogDirectoryCommand}"
                                Classes="Tertiary storage-text-action"
                                ToolTip.Tip="选择日志文件存储文件夹">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolderOpen}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Text="选择文件夹"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Command="{Binding SystemSettings.StorageSettings.RestoreDefaultLogDirectoryCommand}"
                                Classes="Tertiary storage-text-action"
                                ToolTip.Tip="恢复默认日志文件位置">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRestore}"
                                      Width="16"
                                      Height="16" />
                            <TextBlock Text="恢复默认"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12">
                          <TextBlock Classes="helper-text"
                                     Text="已修改，应用后将立即重启"
                                     IsVisible="{Binding SystemSettings.StorageSettings.HasStorageLocationChanges}"
                                     VerticalAlignment="Center" />
                          <Button Content="应用并重启"
                                  Command="{Binding SystemSettings.StorageSettings.ApplyStorageLocationChangesCommand}"
                                  IsEnabled="{Binding SystemSettings.StorageSettings.CanApplyStorageLocationChanges}"
                                  Background="{DynamicResource SemiAccentBrush}"
                                  Foreground="{DynamicResource AppAccentForegroundBrush}"
                                  MinWidth="132" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16"
                            Margin="0,18,12,0">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="当前版本" />
                        <TextBlock Classes="helper-text"
                                   Text="{Binding CurrentAppVersionText}" />
                      </StackPanel>

                      <Button Grid.Column="1"
                              Content="{Binding CheckForUpdatesButtonText}"
                              Command="{Binding CheckForUpdatesCommand}"
                              Classes="Secondary"
                              IsEnabled="{Binding CanCheckForUpdates}"
                              HorizontalContentAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="136" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="18">
                      <Border Width="72"
                              Height="72"
                              CornerRadius="999"
                              ClipToBounds="True"
                              Background="{DynamicResource SemiColorFill0}"
                              BorderBrush="{DynamicResource SemiCardBorderBrush}"
                              BorderThickness="1"
                              VerticalAlignment="Center">
                        <Grid>
                          <Image Source="{Binding ProjectAuthorAvatar}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding HasProjectAuthorAvatar}" />
                          <TextBlock Text="EJ"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource SemiAccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasNoProjectAuthorAvatar}" />
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1"
                                  Spacing="6"
                                  VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="关于项目" />
                        <TextBlock Classes="helper-text"
                                   Text="主作者：EJianZQ" />
                        <SelectableTextBlock Text="https://github.com/EJianZQ/IGoLibrary"
                                             FontSize="12.5"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource SemiTextTertiaryBrush}" />
                      </StackPanel>

                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="12"
                                  VerticalAlignment="Center">
                        <Button Command="{Binding OpenAuthorSponsorPageCommand}"
                                Classes="Secondary"
                                HorizontalContentAlignment="Center"
                                MinWidth="136">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      VerticalAlignment="Center">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="M2 21h18v-2H2v2Zm18-17h-3V3H3v10c0 2.21 1.79 4 4 4h6c1.86 0 3.43-1.28 3.87-3H20c1.66 0 3-1.34 3-3V7c0-1.66-1.34-3-3-3Zm-5 9c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5h10v8Zm6-2c0 .55-.45 1-1 1h-3V6h3c.55 0 1 .45 1 1v4Z" />
                            <TextBlock Text="赞赏作者"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenProjectGitHubPageCommand}"
                                Classes="Secondary"
                                HorizontalContentAlignment="Center"
                                MinWidth="136">
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      VerticalAlignment="Center">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                            <TextBlock Text="打开 GitHub"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Carousel>
          </Grid>
        </Grid>
      </Carousel>

      <Border x:Name="LanCookieRelayDialogOverlay"
              Grid.Row="1"
              ZIndex="31"
              IsVisible="{Binding IsLanCookieRelayDialogOpen}"
              Background="{DynamicResource AppModalOverlayBrush}">
        <Grid Margin="28,16,28,28">
          <Border x:Name="LanCookieRelayDialogModal"
                  Classes="semi-card Shadow"
                  Width="520"
                  MaxWidth="520"
                  Padding="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="18">
              <Grid x:Name="LanCookieRelayDialogHeader"
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="6"
                    ColumnSpacing="12">
                <TextBlock Text="{Binding LanCookieRelayDialogTitle}"
                           FontSize="22"
                           FontWeight="Bold" />

                <Button x:Name="LanCookieRelayCloseButton"
                        Grid.Column="1"
                        Content="{Binding LanCookieRelayCloseButtonText}"
                        Command="{Binding CloseLanCookieRelayCommand}"
                        Classes="Secondary"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" />

                <Grid x:Name="LanCookieRelayStatusPanel"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="6">
                  <PathIcon Width="16"
                            Height="16"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource SemiSuccessTextBrush}"
                            IsVisible="{Binding ShowLanCookieRelayStartedStatusIcon}"
                            Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.2 14.2-4-4 1.4-1.4 2.6 2.6 5.8-5.8L18 9l-7.2 7.2z" />
                  <TextBlock x:Name="LanCookieRelayStatusTextBlock"
                             Grid.Column="1"
                             Text="{Binding LanCookieRelayStatusText}"
                             Classes="helper-text"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap" />
                </Grid>
              </Grid>

              <StackPanel Grid.Row="1"
                          Spacing="8">
                <TextBlock Text="扫描快传页"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                <TextBlock Text="用微信扫描下方二维码打开提交页；页面内可长按识别授权二维码，复制链接后直接提交"
                           Classes="helper-text" />
              </StackPanel>

              <Border Grid.Row="2"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Padding="18"
                      HorizontalAlignment="Center">
                <Grid Width="256"
                      Height="256">
                  <Image Source="{Binding LanCookieRelayQrImage}"
                          Stretch="Uniform"
                         IsVisible="{Binding HasLanCookieRelayQrImage}" />
                  <TextBlock Text="正在生成二维码..."
                             Classes="helper-text"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasNoLanCookieRelayQrImage}" />
                </Grid>
              </Border>

              <StackPanel Grid.Row="3"
                          Spacing="8">
                <TextBlock Classes="field-label" Text="手机访问地址" />
                <TextBox Text="{Binding LanCookieRelayUrlText}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="42" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              ZIndex="30"
              IsVisible="{Binding IsGrabSeatSelectionOverlayOpen}"
              Background="{DynamicResource AppModalOverlayBrush}"
              PointerPressed="OnGrabSeatOverlayPointerPressed">
        <Grid Margin="28,16,28,28">
          <Border x:Name="GrabSeatSelectionModal"
                  Classes="semi-card Shadow"
                  MaxWidth="1180"
                  MaxHeight="760"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  PointerPressed="OnGrabSeatModalPointerPressed">
            <Grid RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="18">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="选择目标座位"
                             FontSize="22"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding DraftSelectedSeatSummaryText}"
                             Classes="helper-text" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="关闭 (X)"
                        Command="{Binding CancelGrabSeatSelectionCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1"
                    ColumnDefinitions="2.1*,Auto,Auto,Auto,Auto"
                    ColumnSpacing="12">
                <TextBox Text="{Binding SeatFilterText}"
                         Watermark="按座位号或标签过滤"
                         VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          Content="隐藏被占座位"
                          IsChecked="{Binding ShowAvailableOnly}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding RefreshSeatsCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Width="16"
                              Height="16"
                              Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" />
                    <TextBlock Text="刷新" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding SaveFavoritesCommand}"
                        IsEnabled="{Binding HasDraftSelectedSeats}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Width="16"
                              Height="16"
                              Data="M12,2.2 L14.9,8.07 L21.38,9.01 L16.69,13.58 L17.8,20.03 L12,16.98 L6.2,20.03 L7.31,13.58 L2.62,9.01 L9.1,8.07 Z" />
                    <TextBlock Text="收藏" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Command="{Binding SetSelectedSeatLabelCommand}"
                        IsEnabled="{Binding CanSetSelectedSeatLabel}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Grid Width="15" Height="15">
                      <Path Data="M2,2 L8,2 L15,9 L9,15 L2,8 Z"
                            Fill="Transparent"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="1.8"
                            Stretch="Fill" />
                      <Ellipse Width="3"
                               Height="3"
                               Margin="4,4,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Fill="{Binding $parent[Button].Foreground}" />
                    </Grid>
                    <TextBlock Text="加标签" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border Grid.Row="2"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Padding="16">
                <Grid>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding HasSeatLayout}">
                    <ItemsControl ItemsSource="{Binding VisibleSeats}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>

                  <Border Background="{DynamicResource AppOverlaySurfaceStrongBrush}"
                          CornerRadius="14"
                          Padding="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding HasNoSeatLayout}">
                    <TextBlock Text="当前场馆暂无可编辑的座位布局，请先刷新或重新绑定场馆"
                               Classes="helper-text"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>

                  <Border Background="{DynamicResource AppOverlaySurfaceStrongBrush}"
                          CornerRadius="14"
                          Padding="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowSeatFilterEmptyState}">
                    <TextBlock Text="当前筛选条件下没有可显示的座位"
                               Classes="helper-text"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>

                  <Border Background="{DynamicResource AppOverlaySurfaceSoftBrush}"
                          CornerRadius="16"
                          IsVisible="{Binding IsApplyingSeatFilter}">
                    <StackPanel Width="220"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <ProgressBar IsIndeterminate="True"
                                   Height="4"
                                   Foreground="{DynamicResource SemiAccentBrush}" />
                      <TextBlock Text="正在应用筛选并刷新座位工作区..."
                                 Classes="helper-text"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="3"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="关闭只会放弃本次目标座位勾选；已经保存的座位标签不会撤销"
                           Classes="helper-text"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="确认完成"
                        Command="{Binding ConfirmGrabSeatSelectionCommand}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              ZIndex="30"
              IsVisible="{Binding IsMobileControlDetailsOpen}"
              Background="{DynamicResource AppModalOverlayBrush}">
        <Grid Margin="28,16,28,28">
          <Border x:Name="MobileControlDetailsModal"
                  Classes="semi-card Shadow"
                  MaxWidth="560"
                  Padding="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="18">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="服务详情"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="关闭"
                        Command="{Binding CloseMobileControlDetailsCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <StackPanel Grid.Row="1"
                          Spacing="12">
                <Border Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="固定端口"
                               Classes="grab-stat-title" />
                    <TextBlock Text="{Binding MobileControlPort}"
                               FontSize="22"
                               FontWeight="Bold" />
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="访问令牌"
                               Classes="grab-stat-title" />
                    <SelectableTextBlock Text="{Binding MobileControlAccessTokenFullText}"
                                         FontFamily="Consolas, Cascadia Mono, Monaco, monospace"
                                         FontSize="13"
                                         TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <Grid Grid.Row="2"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                <Button Content="随机新端口"
                        Command="{Binding RandomizeMobileControlPortCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="重置访问令牌"
                        Command="{Binding ResetMobileControlAccessTokenCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              ZIndex="30"
              IsVisible="{Binding IsGlobalLeakLibraryPickerOpen}"
              Background="{DynamicResource AppModalOverlayBrush}"
              PointerPressed="OnGlobalLeakLibraryOverlayPointerPressed">
        <Grid Margin="28,16,28,28">
          <Border x:Name="GlobalLeakLibraryPickerModal"
                  Classes="semi-card Shadow"
                  MaxWidth="1180"
                  MaxHeight="760"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  PointerPressed="OnGlobalLeakLibraryModalPointerPressed">
            <Grid x:Name="GlobalLeakLibraryPickerContent"
                  RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="18">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="选择扫描场馆"
                             FontSize="22"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding DraftGlobalLeakLibrarySummaryText}"
                             Classes="helper-text" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="GlobalLeakLibraryPickerCloseButton"
                        Content="关闭 (X)"
                        Command="{Binding CancelGlobalLeakLibrariesCommand}"
                        IsEnabled="{Binding CanCancelGlobalLeakLibraryPicker}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1"
                    x:Name="GlobalLeakLibraryPickerActions"
                    ColumnDefinitions="*,Auto,Auto,Auto"
                    ColumnSpacing="12"
                    IsEnabled="{Binding CanEditGlobalLeakConfiguration}">
                <TextBlock Text="多选场馆后按确认同步到全域捡漏任务"
                           Classes="helper-text"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="刷新"
                        Command="{Binding RefreshGlobalLeakLibrariesCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="全选"
                        Command="{Binding SelectAllGlobalLeakLibrariesCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="3"
                        Content="清空"
                        Command="{Binding ClearDraftGlobalLeakLibrariesCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Grid Grid.Row="2"
                    x:Name="GlobalLeakLibraryPickerColumns"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16"
                    IsEnabled="{Binding CanEditGlobalLeakConfiguration}">
                <Border Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                  <Grid RowDefinitions="Auto,*"
                        RowSpacing="12">
                    <TextBlock Text="可选场馆"
                               FontSize="16"
                               FontWeight="Bold" />

                    <Grid Grid.Row="1">
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GlobalLeakLibraries}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GlobalLeakLibraryItemViewModel">
                              <Border Margin="0,0,0,10"
                                      Padding="14"
                                      CornerRadius="14"
                                      Background="{DynamicResource SemiCardBackgroundBrush}"
                                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                      BorderThickness="1">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                  <Grid ColumnDefinitions="*,Auto"
                                        ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{Binding LibraryName}"
                                                 FontSize="15"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource SemiTextPrimaryBrush}" />
                                      <TextBlock Text="{Binding Floor}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SemiColorText2}" />
                                      <TextBlock Text="{Binding SeatSummary}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="10,5"
                                            CornerRadius="999"
                                            Background="{DynamicResource SemiAccentSoftBrush}"
                                            BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                      <TextBlock Text="{Binding OpenStatusText}"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource SemiAccentBrush}" />
                                    </Border>
                                  </Grid>
                                </CheckBox>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>

                      <Border Background="{DynamicResource AppOverlaySurfaceStrongBrush}"
                              CornerRadius="14"
                              Padding="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasNoGlobalLeakLibraries}">
                        <TextBlock Text="当前账号暂无可选择的场馆，请刷新后重试"
                                   Classes="helper-text"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Column="1"
                        x:Name="GlobalLeakPriorityPanel"
                        Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                  <Grid RowDefinitions="Auto,*"
                        RowSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="扫描优先级"
                                 FontSize="16"
                                 FontWeight="Bold" />
                      <TextBlock Text="从上到下扫描，可拖动或使用箭头调整"
                                 Classes="helper-text" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                      <ScrollViewer x:Name="GlobalLeakPriorityScrollViewer"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnGlobalLeakPriorityScrollViewerDragOver"
                                    DragDrop.DragLeave="OnGlobalLeakPriorityScrollViewerDragLeave"
                                    DragDrop.Drop="OnGlobalLeakPriorityScrollViewerDrop">
                        <controls:AnimatedReorderItemsControl
                            x:Name="GlobalLeakPriorityItemsControl"
                            ItemsSource="{Binding DraftGlobalLeakLibraryPriorities}"
                            IsVisible="{Binding HasDraftGlobalLeakLibraries}"
                            ReorderAnimationDuration="0:0:0.22">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GlobalLeakLibraryPriorityItemViewModel">
                              <Grid Margin="0,0,0,8"
                                    RowDefinitions="2,Auto,2">
                                <Border Height="2"
                                        Background="{DynamicResource SemiAccentBrush}"
                                        IsVisible="{Binding IsDropBefore}" />
                                <Border Grid.Row="1"
                                        Padding="10"
                                        CornerRadius="12"
                                        Background="{DynamicResource SemiCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SemiCardBorderBrush}"
                                        BorderThickness="1"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnGlobalLeakPriorityDragOver"
                                        DragDrop.DragLeave="OnGlobalLeakPriorityDragLeave"
                                        DragDrop.Drop="OnGlobalLeakPriorityDrop">
                                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                        ColumnSpacing="8">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="{DynamicResource SemiAccentSoftBrush}"
                                            VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Priority}"
                                                 Foreground="{DynamicResource SemiAccentBrush}"
                                                 FontWeight="Bold"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                      <TextBlock Text="{Binding LibraryName}"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding Floor}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource SemiColorFill1}"
                                            Cursor="SizeAll"
                                            ToolTip.Tip="拖动调整扫描优先级"
                                            AutomationProperties.Name="拖动调整扫描优先级"
                                            PointerPressed="OnGlobalLeakPriorityDragHandlePointerPressed"
                                            PointerMoved="OnGlobalLeakPriorityDragHandlePointerMoved"
                                            PointerReleased="OnGlobalLeakPriorityDragHandlePointerReleased"
                                            PointerCaptureLost="OnGlobalLeakPriorityDragHandlePointerCaptureLost">
                                      <TextBlock Text="☰"
                                                 FontSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <Button Grid.Column="3"
                                            Content="↑"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Command="{Binding DataContext.MoveGlobalLeakLibraryUpCommand, ElementName=MainWindowRoot}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Classes="Secondary"
                                            ToolTip.Tip="提高扫描优先级"
                                            AutomationProperties.Name="提高扫描优先级" />
                                    <Button Grid.Column="4"
                                            Content="↓"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Command="{Binding DataContext.MoveGlobalLeakLibraryDownCommand, ElementName=MainWindowRoot}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Classes="Secondary"
                                            ToolTip.Tip="降低扫描优先级"
                                            AutomationProperties.Name="降低扫描优先级" />
                                  </Grid>
                                </Border>
                                <Border Grid.Row="2"
                                        Height="2"
                                        Background="{DynamicResource SemiAccentBrush}"
                                        IsVisible="{Binding IsDropAfter}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </controls:AnimatedReorderItemsControl>
                      </ScrollViewer>

                      <Border x:Name="GlobalLeakPriorityEmptyState"
                              Background="Transparent"
                              CornerRadius="14"
                              Padding="20"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasNoDraftGlobalLeakLibraries}">
                        <TextBlock Text="请在左侧勾选场馆；新选择的场馆会追加为最低优先级"
                                   Classes="helper-text"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>

              <Grid Grid.Row="3"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="确认后保存当前优先级；关闭或点击弹窗外部会放弃本次全部修改"
                           Classes="helper-text"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="GlobalLeakLibraryPickerConfirmButton"
                        Content="确认完成"
                        Command="{Binding ConfirmGlobalLeakLibrariesCommand}"
                        IsEnabled="{Binding CanEditGlobalLeakConfiguration}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Canvas x:Name="GlobalLeakPriorityDragOverlay"
                      Grid.RowSpan="4"
                      ZIndex="50"
                      ClipToBounds="True"
                      IsHitTestVisible="False">
                <Border x:Name="GlobalLeakPriorityDragGhost"
                        x:DataType="vm:GlobalLeakLibraryPriorityItemViewModel"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="340"
                        Padding="12"
                        CornerRadius="12"
                        Background="{DynamicResource SemiCardBackgroundBrush}"
                        BorderBrush="{DynamicResource SemiAccentBrush}"
                        BorderThickness="1"
                        Opacity="0.72"
                        IsVisible="False"
                        IsHitTestVisible="False">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource SemiAccentSoftBrush}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Priority}"
                                 Foreground="{DynamicResource SemiAccentBrush}"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding LibraryName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Floor}"
                                 FontSize="12"
                                 Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="拖动中"
                               FontSize="12"
                               Foreground="{DynamicResource SemiAccentBrush}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Canvas>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              ZIndex="30"
              IsVisible="{Binding IsTomorrowSeatSelectionOverlayOpen}"
              Background="{DynamicResource AppModalOverlayBrush}"
              PointerPressed="OnTomorrowSeatOverlayPointerPressed">
        <Grid Margin="28,16,28,28">
          <Border x:Name="TomorrowSeatSelectionModal"
                  Classes="semi-card Shadow"
                  MaxWidth="1180"
                  MaxHeight="760"
                  Padding="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  PointerPressed="OnTomorrowSeatModalPointerPressed">
            <Grid RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="18">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="选择明日预约座位"
                             FontSize="22"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding DraftSelectedTomorrowSeatSummaryText}"
                             Classes="helper-text" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="关闭 (X)"
                        Command="{Binding CancelTomorrowSeatSelectionCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1"
                    ColumnDefinitions="2.1*,Auto,Auto"
                    ColumnSpacing="12">
                <TextBox Text="{Binding TomorrowSeatFilterText}"
                         Watermark="仅按座位号过滤"
                         VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="刷新"
                        Command="{Binding RefreshTomorrowSeatsCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="清空选择"
                        Command="{Binding ClearTomorrowSeatCommand}"
                        Classes="Secondary"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Border Grid.Row="2"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Padding="16">
                <Grid>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding HasTomorrowSeatLayout}">
                    <ItemsControl ItemsSource="{Binding TomorrowVisibleSeats}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>

                  <Border Background="{DynamicResource AppOverlaySurfaceStrongBrush}"
                          CornerRadius="14"
                          Padding="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding HasNoTomorrowSeatLayout}">
                    <TextBlock Text="当前场馆暂无可选择的座位布局，请先刷新或重新绑定场馆"
                               Classes="helper-text"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>

                  <Border Background="{DynamicResource AppOverlaySurfaceStrongBrush}"
                          CornerRadius="14"
                          Padding="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowTomorrowSeatFilterEmptyState}">
                    <TextBlock Text="当前筛选条件下没有可显示的座位"
                               Classes="helper-text"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="3"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="明日预约首版只支持一个目标座位；只有点击“确认完成”才会同步本次选择"
                           Classes="helper-text"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="确认完成"
                        Command="{Binding ConfirmTomorrowSeatSelectionCommand}"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              ZIndex="20"
              IsVisible="{Binding IsVenuePickerOpen}"
              Background="{DynamicResource AppBackdropOverlayBrush}">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Margin="24,8,24,24">
          <Border x:Name="VenuePickerModal"
                  Classes="semi-card Shadow"
                  Width="400"
                  MaxWidth="400"
                  MaxHeight="600"
                  Padding="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*" RowSpacing="16">
              <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="选择作业场馆"
                             FontSize="20"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="关闭"
                          Command="{Binding CloseVenuePickerCommand}"
                          Classes="Secondary"
                          HorizontalContentAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="下方已自动刷新最新场馆列表，点击一个场馆后，Dashboard 会立即刷新为该场馆预览"
                           Classes="helper-text" />
              </Grid>

              <Border Grid.Row="1"
                      Background="{DynamicResource SemiColorFill0}"
                      BorderBrush="{DynamicResource SemiCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="8"
                      VerticalAlignment="Stretch">
                <ListBox ItemsSource="{Binding AvailableLibraries}"
                         SelectedItem="{Binding SelectedLibrary}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Stretch"
                         Margin="0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto"
                            Margin="4"
                            MinHeight="72"
                            PointerReleased="OnVenuePickerItemPointerReleased">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Floor}"
                                     FontSize="12"
                                     Foreground="{DynamicResource SemiColorText2}" />
                          <TextBlock FontSize="12"
                                     Foreground="{DynamicResource SemiColorText2}">
                            <Run Text="总座 " />
                            <Run Text="{Binding TotalSeats}" />
                            <Run Text=" · 已占用 " />
                            <Run Text="{Binding UsedSeats}" />
                            <Run Text=" · 已预定 " />
                            <Run Text="{Binding BookedSeats}" />
                          </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Theme="{DynamicResource TagLabel}"
                                Classes="Green"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsOpen}">
                          <TextBlock Text="开放中" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
