<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\main.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MobileControl\MobileControlPage.html" />
    <EmbeddedResource Include="Assets\qrcode.png" LogicalName="IGoLibrary.Ex.Desktop.Assets.qrcode.png" />
    <EmbeddedResource Include="..\..\build\cloudflared-assets.json"
                      Link="Resources\Cloudflared\cloudflared-assets.json"
                      LogicalName="IGoLibrary.Ex.Desktop.Resources.Cloudflared.cloudflared-assets.json" />
    <EmbeddedResource Include="..\..\build\third-party\cloudflared-LICENSE.txt"
                      Link="Resources\Cloudflared\LICENSE.txt"
                      LogicalName="IGoLibrary.Ex.Desktop.Resources.Cloudflared.LICENSE.txt" />
    <EmbeddedResource Include="..\..\build\third-party\THIRD-PARTY-NOTICES.txt"
                      Link="Resources\Cloudflared\THIRD-PARTY-NOTICES.txt"
                      LogicalName="IGoLibrary.Ex.Desktop.Resources.Cloudflared.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IGoLibrary.Ex.Application\IGoLibrary.Ex.Application.csproj" />
    <ProjectReference Include="..\IGoLibrary.Ex.Domain\IGoLibrary.Ex.Domain.csproj" />
    <ProjectReference Include="..\IGoLibrary.Ex.Infrastructure\IGoLibrary.Ex.Infrastructure.csproj" />
    <ProjectReference Include="..\IGoLibrary.Ex.Updater.Core\IGoLibrary.Ex.Updater.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.7.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="PrepareCloudflaredForVisualStudioDebug"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(BuildingInsideVisualStudio)' == 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="pwsh.exe -NoLogo -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\build\prepare-cloudflared.ps1&quot; -Runtime win-x64 -DestinationDirectory &quot;$(TargetDir)tools\cloudflared&quot; -Offline"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
